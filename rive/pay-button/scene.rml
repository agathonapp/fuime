            <KeyedObject objectId="0:11">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="4" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="10" interpolationType="hold"/>
