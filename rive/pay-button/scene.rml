                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- the button collapses into a spinner -->
        <LinearAnimation fps="60" duration="96" name="Processing" id="0:33">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="20">
                    <KeyFrameDouble value="300" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.5" y1="0" x2="0.2" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="64" frame="18" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:17">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="8" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="0" frame="10" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="20" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:16">
                <KeyedProperty propertyKey="116">
                    <KeyFrameDouble value="0" frame="18" interpolationType="linear"/>
                    <KeyFrameDouble value="2" frame="96" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:10">
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="14"><KeyFrameDouble value="210" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:11">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:13">
                <KeyedProperty propertyKey="115"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:21">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="16"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
                <KeyedProperty propertyKey="17"><KeyFrameDouble value="1" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:22">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- it lands -->
        <LinearAnimation fps="60" duration="132" name="Paid" id="0:34">
            <KeyedObject objectId="0:20">
                <KeyedProperty propertyKey="20"><KeyFrameDouble value="64" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:17">
                <KeyedProperty propertyKey="18"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="6" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:16">
                <KeyedProperty propertyKey="116"><KeyFrameDouble value="0" frame="0" interpolationType="hold"/></KeyedProperty>
