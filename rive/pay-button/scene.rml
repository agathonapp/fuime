                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="46" interpolationType="hold"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.84" frame="0" interpolationType="elastic">
