                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="30" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:10">
                <KeyedProperty propertyKey="16">
