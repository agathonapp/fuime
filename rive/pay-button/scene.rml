                    </StateTransition>
                    <StateTransition stateToId="0:63" duration="70" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <AnimationState x="700" y="0" animationId="0:33" id="0:63">
                    <StateTransition stateToId="0:64" duration="90" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <AnimationState x="920" y="0" animationId="0:34" id="0:64">
                    <StateTransition stateToId="0:60" duration="260" enableExitTime="true" exitTimeIsPercetange="true" exitTime="100"/>
                </AnimationState>

                <!-- four listeners, writing two booleans -->

            </StateMachineLayer>

            <StateMachineListenerSingle targetId="0:19" listenerTypeValue="enter" name="In" id="0:70">
                <ListenerViewModelChange>
