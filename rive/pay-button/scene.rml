            <KeyedObject objectId="0:21">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="1" frame="8" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.15" y1="0.6" x2="0.4" y2="1"/>
