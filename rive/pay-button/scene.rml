                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="false"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <!-- Order matters. A pointer that leaves while held clears BOTH
                     booleans, so the bail-out is tested before the commit. -->
                <AnimationState x="480" y="0" animationId="0:32" id="0:62">
                    <StateTransition stateToId="0:60" duration="130">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
