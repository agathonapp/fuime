                    <KeyFrameDouble value="1" frame="48" interpolationType="hold"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="240" y="-140"/>
                <ExitState x="460" y="-140"/>
                <EntryState><StateTransition stateToId="0:60"/></EntryState>

                <AnimationState x="60" y="0" animationId="0:30" id="0:60">
                    <StateTransition stateToId="0:61" duration="130" enableEarlyExit="true">
                        <TransitionViewModelCondition>
                            <TransitionPropertyViewModelComparator>
                                <BindablePropertyBoolean><DataBindContext sourcePathIds="0:40-0:45" propertyKey="634"/></BindablePropertyBoolean>
                            </TransitionPropertyViewModelComparator>
                            <TransitionValueBooleanComparator value="true"/>
                        </TransitionViewModelCondition>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="260" y="0" animationId="0:31" id="0:61">
                    <StateTransition stateToId="0:62" duration="0" enableEarlyExit="true">
