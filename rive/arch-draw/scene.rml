        <!-- The flood. No paint, so it masks without drawing. originY=1 pins
             it to its own bottom edge, so keying height alone grows it upward. -->
        <Shape x="300" y="500" name="Flood" id="0:30">
            <Rectangle width="460" height="0" originX="0.5" originY="1" name="Path" id="0:31"/>
        </Shape>

        <Fill name="Background" id="0:40">
            <SolidColor colorValue="FFF9F8F7" name="Color"/>
        </Fill>

        <LinearAnimation fps="60" duration="170" name="Draw" id="0:6">
            <!-- the outline draws on -->
            <KeyedObject objectId="0:16">
                <KeyedProperty propertyKey="115">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.2" y1="0" x2="0.3" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="78" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- the colour floods up behind it -->
            <KeyedObject objectId="0:31">
                <KeyedProperty propertyKey="21">
                    <KeyFrameDouble value="0" frame="46" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.45" y1="0" x2="0.2" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="360" frame="128" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- the outline hands over to the fill and leaves -->
            <KeyedObject objectId="0:14">
                <KeyedProperty propertyKey="18">
                    <KeyFrameDouble value="1" frame="112" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.42" y1="0" x2="0.58" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="0" frame="146" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>

            <!-- and the whole mark settles, slightly past its resting size -->
            <KeyedObject objectId="0:10">
                <KeyedProperty propertyKey="16">
                    <KeyFrameDouble value="0.94" frame="40" interpolationType="elastic">
                        <ElasticInterpolator easingValue="1" amplitude="0.9" period="0.55"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="150" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.94" frame="40" interpolationType="elastic">
                        <ElasticInterpolator easingValue="1" amplitude="0.9" period="0.55"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="150" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState><StateTransition stateToId="0:12"/></EntryState>
                <AnimationState x="200" animationId="0:6" id="0:12"/>
            </StateMachineLayer>
        </StateMachine>
