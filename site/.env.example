# Waitlist sinks. At least ONE group must be set or /api/waitlist returns 503.

# Durable, deduped storage (preferred). Free tier at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notification email per signup.
RESEND_API_KEY=
WAITLIST_NOTIFY_TO=
# Must be a domain verified in Resend. Falls back to Resend's sandbox sender.
WAITLIST_NOTIFY_FROM=fuime <hi@fuime.com>
