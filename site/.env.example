# Local: cp .env.example .env, fill in, then `npm start` (or set them inline).
# Deployed: these are set on the fuime-site service in the Render dashboard.

# Where /login and /signup send people. The Rails app.
APP_ORIGIN=https://app.fuime.com

# Waitlist sinks. At least ONE group must be set or /api/waitlist returns 503.

# Durable, deduped storage (preferred). A Render Key Value instance — on Render
# this is wired from fuime-redis by render.yaml, so it is only set by hand here.
# Must be a plan WITH persistence: free instances lose everything on restart,
# which is how the first signups came to exist only in an inbox.
WAITLIST_REDIS_URL=redis://localhost:6379/2

# Notification email per signup.
RESEND_API_KEY=
WAITLIST_NOTIFY_TO=
# Must be a domain verified in Resend. Falls back to Resend's sandbox sender.
WAITLIST_NOTIFY_FROM=fuime <rushil@fuime.com>
