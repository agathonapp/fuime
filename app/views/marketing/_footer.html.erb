<%# Standardized marketing footer. Shared by every /for/* landing page — keep it
    page-agnostic. NOTE: the Stripe / card-issuing disclosure below is REQUIRED because
    marketing pages name Stripe as a financial partner. %>
<footer class="marketing-footer">
  <div class="marketing-footer__inner">
    <% logo_env = Rails.env.local? ? "development" : Rails.env %>
    <div class="marketing-footer__brand">
      <%= image_tag "logo-#{logo_env}-dark.svg", alt: "Fuime", height: 32 %>
      <%# Was "The foundation for your nonprofit." — HCB's tagline, describing
          a product Fuime does not offer (CLAUDE.md L8). %>
      <p>The financial home for teen businesses.</p>
    </div>

    <%# Every link in this nav used to point at hackclub.com, help.hcb.hackclub.com
        or blog.hcb.hackclub.com — sending Fuime's own visitors to Hack Club's
        fiscal-sponsorship product, and its Terms link to Hack Club's terms.
        Fuime's own pages only (CLAUDE.md Rule 7, Prime Directive 4). %>
    <nav class="marketing-footer__cols" aria-label="Footer">
      <div>
        <h3>Product</h3>
        <a href="<%= root_path %>">For teen founders</a>
        <a href="<%= funders_path %>">For funders</a>
      </div>
      <div>
        <h3>Resources</h3>
        <a href="<%= faq_path %>">FAQ</a>
        <a href="<%= branding_path %>">Branding</a>
      </div>
      <div>
        <h3>Legal</h3>
        <a href="<%= terms_path %>">Terms</a>
        <a href="<%= privacy_path %>">Privacy</a>
        <a href="<%= guardian_agreement_path %>">Guardian agreement</a>
        <a href="<%= security_path %>">Security</a>
      </div>
    </nav>
  </div>

  <div class="marketing-footer__legal">
    <p>
      Fuime is a program of The Hack Foundation (d.b.a. Hack Club), a 501(c)(3) nonprofit
      (EIN: 81-2908499).
    </p>
    <p>
      Fuime Visa® Commercial cards are powered by Stripe and issued by Celtic Bank. Banking
      services provided by Column N.A., Member FDIC.
    </p>
  </div>
</footer>
