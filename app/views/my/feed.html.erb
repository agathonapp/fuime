<% title "My feed" %>
<% page_md %>
<%= render "users/nav", selected: :feed %>
<%= render "my/following_modal", event_follows: @event_follows %>

<h1 class="heading flex items-center border-0 mb-0">
  <span class="flex-grow">Feed</span>
  <% if @event_follows.any? %>
    <%= link_to my_feed_path, class: "btn bg-blue flex", data: { behavior: "modal_trigger", modal: "edit_following" } do %>
      <%= inline_icon "settings" %>
      Manage
    <% end %>
  <% end %>
</h1>

<% if @announcements.empty? %>
  <div class="flex flex-1 flex-col items-center justify-center">
    <div class="text-center">
      <h3 class="text-2xl font-bold mb-0">
        It's quiet here...
      </h3>
      <% if @event_follows.any? %>
        <p class="text-gray-500 my-1 max-w-sm">
          No announcements are posted yet.
        </p>
      <% else %>
        <p class="text-gray-500 my-1 max-w-sm">
          Follow a transparent business to see updates from them here.
        </p>
        <%# Fuime: "View all organizations" linked to Hack Club's fiscal-sponsorship
            directory with utm_source=hcb — a Fuime empty state sending founders to
            another company's list of nonprofits. Fuime has its own directory. %>
        <%= link_to fuime_discover_path, class: "muted" do %>
          Discover businesses on Fuime
        <% end %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="flex flex-col gap-2">
    <% @announcements.each do |announcement| %>
      <%= render partial: "announcements/announcement_card", locals: { announcement:, show_event: true } %>
    <% end %>
  </div>
<% end %>

<%= paginate @announcements %>
