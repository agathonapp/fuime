<p>
  Hi <%= @user.first_name %>.
</p>

<p>
  We're writing to let you know that you just signed into Fuime from a new device
  <% if @session.device_info.present? %>
    on <b><%= @session.device_info %></b>
  <% end %>

  <% if @session.os_info.present? %>
    running <b><%= @session.os_info %></b>
  <% end %>
</p>

<p>
  IP address:
  <b>
    <% if @session.ip.present? %>
      <%= @session.ip %>
    <% else %>
      Unknown
    <% end %>
  </b>
</p>

<% map_url = @session.latitude ? ApplicationHelper.static_map_url(lat: @session.latitude, lng: @session.longitude) : nil %>
<% if map_url %>
  <img
    src="<%= map_url %>&size=640x320"
    style="border-radius: 0.5rem; width: 80%">
<% end %>

<p>
  If this is unexpected, please review
  <%= link_to "your Fuime account's security settings", settings_security_url %>
  and contact us at
  <%= link_to "support@fuime.com", "mailto:support@fuime.com" %>.
</p>

<p>
  Thanks,<br>
  The Fuime Team
</p>
