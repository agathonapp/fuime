<% title "Operator vetting (Fuime)" %>

<%# FUIME: the queue where a human decides whether an operator may sell.

    Deliberately unglamorous and deliberately manual. Under merchant-of-record
    Fuime LLC is the legal seller of everything an operator sells, so Fuime
    inherits their liability by design — and the compensating control is that
    somebody looks at each one. The first hundred decisions made on this page are
    the training data for the risk model that eventually replaces it, which is
    why the notes field matters more than it looks.

    Separate from admin/applications, which asks whether a venture should EXIST.
    This asks whether it may SELL — revocable, and asked again whenever something
    changes. See Fuime::OperatorEligibility. %>

<%= form_with local: true, class: "card", url: operator_vetting_admin_index_path, method: :get do |form| %>
  <%= render "events/filters/search", form: %>

  <div class="flex flex-col sm:flex-row items-center gap-2 mt-2">
    <div class="flex items-center gap-2">
      <%= form.label :status, "Status" %>
      <%= form.select :status,
                      options_for_select(
                        [["All", ""]] + Event.operator_vetting_statuses.keys.map { |s| [s.humanize, s] },
                        @status
                      ) %>
    </div>

    <%= form.submit "Search", class: "ml-auto" %>
  </div>
<% end %>

<div class="flex items-center gap-2 mb2 flex-wrap">
  <% Event.operator_vetting_statuses.keys.each do |status| %>
    <%= link_to operator_vetting_admin_index_path(status:), class: "badge #{status == 'unvetted' ? 'bg-warning' : 'bg-muted'}" do %>
      <%= status.humanize %>: <%= @counts[status] || 0 %>
    <% end %>
  <% end %>
</div>

<div class="flex items-center mb2 flex-col sm:flex-row">
  <div class="flex-grow">
    <%= page_entries_info @events, entry_name: "ventures" %>
  </div>
  <%= paginate @events %>
</div>

<table class="min-w-0">
  <thead>
    <tr>
      <th class="w-24">ID</th>
      <th>Venture</th>
      <th>Operators</th>
      <th>Sells</th>
      <th>Status</th>
      <th>Blockers</th>
      <th class="w-64">Decision</th>
    </tr>
  </thead>
  <tbody>
    <% @events.each do |event| %>
      <tr class="<%= "admin-bg-pending" if event.operator_vetting_unvetted? %>">
        <td><%= event.id %></td>
        <td>
          <%= link_to event.name, event_path(event) %>
          <div class="muted"><%= event.created_at.strftime("%Y-%m-%d") %></div>
        </td>
        <td>
          <%# Ages are shown because they are the decision. Admin-only page. %>
          <% event.users.each do |user| %>
            <div>
              <%= user_mention(user) %>
              <span class="muted"><%= user.age ? user.age.to_s : "age unknown" %></span>
            </div>
          <% end %>
        </td>
        <%# FUIME: what the applicant actually said.

            This page decides whether a venture may sell, and until now it showed
            a category and nothing else — so the only way to review an
            application was to open it in another tab, which is how a queue stops
            being read and starts being cleared.

            Everything here is the applicant's own words. Nothing is Fuime's
            assessment; the reviewer supplies that in the notes field. %>
        <td>
          <% app = event.application %>
          <strong><%= app&.service&.name || event.business_category.presence&.titleize ||
                        content_tag(:span, "not set", class: "muted") %></strong>

          <%# FUIME: the category is what decides whether this venture may sell at
              all (Fuime::OperatorEligibility#category_blocker fails closed on
              blank), and it is written exactly once at activation. A venture whose
              application carried no category is stuck behind a message telling the
              founder to choose something they cannot reach — so the choice lives
              here, with the person who is already reading the application.

              Prominent when blank, folded away when set: changing it re-answers
              what Fuime vetted and, under merchant-of-record, what Fuime sells as.
              That should take a deliberate click. %>
          <% if event.business_category.blank? %>
            <div class="mt1 pa1" style="border: 1px solid var(--warning); border-radius: 4px;">
              <div class="text-sm bold">No category — this venture cannot sell.</div>
              <%= form_with url: operator_vetting_category_admin_index_path(id: event.slug),
                            method: :post, local: true do |form| %>
                <%= form.select :business_category,
                                Event::BUSINESS_CATEGORIES.map { |c| [c.titleize, c] },
                                { include_blank: "Choose…" },
                                class: "mt1" %>
                <%= form.submit "Set category", class: "btn bg-accent mt1" %>
              <% end %>
            </div>
          <% else %>
            <details class="mt1">
              <summary class="muted text-sm">Change category</summary>
              <%= form_with url: operator_vetting_category_admin_index_path(id: event.slug),
                            method: :post, local: true do |form| %>
                <%= form.select :business_category,
                                Event::BUSINESS_CATEGORIES.map { |c| [c.titleize, c] },
                                { selected: event.business_category },
                                class: "mt1" %>
                <%= form.submit "Update", class: "btn bg-muted mt1" %>
              <% end %>
            </details>
          <% end %>

          <% if app&.description.present? %>
            <div class="muted mt1" style="white-space: pre-wrap; max-width: 22rem;"><%= app.description %></div>
          <% end %>

          <% if app&.website_url.present? %>
            <div class="mt1">
              <%# rel="noopener nofollow" and a new tab: this is an unvetted URL
                  a stranger typed, being opened by a Fuime admin. %>
              <%= link_to app.website_url, app.website_url, target: "_blank",
                          rel: "noopener nofollow", class: "text-sm" %>
            </div>
          <% end %>

          <% if app&.starting_point.present? %>
            <div class="muted text-sm mt1">
              <%= Fuime::ServiceCatalog.starting_point(app.starting_point)&.name %>
            </div>
          <% end %>

          <%# Surfaced rather than buried: a political declaration is the one
              answer on the application that changes what a reviewer should be
              looking for. %>
          <% if app&.political? %>
            <details class="mt1">
              <summary class="badge bg-warning">Political activity declared</summary>
              <div class="muted text-sm" style="white-space: pre-wrap;"><%= app.political_description %></div>
            </details>
          <% end %>
        </td>
        <td><%= event.operator_vetting_status.humanize %></td>
        <td>
          <%# Empty here means "nothing is stopping them", which under Connect is a
              narrower claim than under merchant-of-record — the launch-scope checks
              only bind once Fuime is the seller. See Fuime::OperatorEligibility. %>
          <% blockers = event.selling_blockers %>
          <% if blockers.empty? %>
            <span class="muted">None</span>
          <% else %>
            <ul class="mb-0 pl-3">
              <% blockers.each do |blocker| %>
                <li><%= blocker %></li>
              <% end %>
            </ul>
          <% end %>
        </td>
        <td>
          <%= form_with url: operator_vetting_decide_admin_index_path(id: event.slug), method: :post, local: true do |form| %>
            <%# Prefilled with FACTS from the application, never a judgement.

                `record_vetting_decision!` stamps this with the time and the
                reviewer's name, so whatever is in this box becomes something a
                named human is on record as having written. Prefilling "looks
                legitimate" would put words in their mouth on the one control the
                whole model rests on — and somebody clearing a queue would sign
                them unread. The trailing "— " is an open clause inviting the
                sentence that actually matters. See Event::Application#vetting_summary. %>
            <%= form.text_field :notes,
                                value: event.application&.vetting_summary,
                                placeholder: "Why (kept on the record)",
                                class: "w-full mb1" %>
            <%# form.button, not form.submit: a submit tag's label IS its value, so
                three submits named "status" would post status=Approve. A button
                carries a value independent of the text on it. %>
            <div class="flex gap-1 flex-wrap">
              <% unless event.operator_vetting_approved? %>
                <%= form.button "Approve", name: "status", value: "approved" %>
              <% end %>
              <% unless event.operator_vetting_suspended? %>
                <%= form.button "Suspend", name: "status", value: "suspended" %>
              <% end %>
              <% unless event.operator_vetting_rejected? %>
                <%= form.button "Reject", name: "status", value: "rejected" %>
              <% end %>
            </div>
          <% end %>

          <% if event.operator_vetted_at %>
            <div class="muted mt1">
              <%= event.operator_vetting_status.humanize %>
              <%= "by #{event.operator_vetted_by.name}" if event.operator_vetted_by %>
              on <%= event.operator_vetted_at.strftime("%Y-%m-%d") %>
            </div>
          <% end %>

          <% if event.operator_vetting_notes.present? %>
            <details class="mt1">
              <summary class="muted">Notes</summary>
              <div class="muted" style="white-space: pre-wrap;"><%= event.operator_vetting_notes %></div>
            </details>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @events %>
