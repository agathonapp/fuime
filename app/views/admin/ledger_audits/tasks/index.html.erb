<%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>

<h3>Transactions Flagged During Ledger Audits (<%= Admin::LedgerAudit::Task.flagged.count %> unresolved)</h3>

<div>
  <table>
    <thead>
      <tr>
        <th class="w-40">Date</th>
        <th>Flagged By</th>
        <th>Event Point of Contact</th>
        <th>Memo</th>
        <th>Amount</th>
        <th>Receipts</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <% hcb_code = task.hcb_code %>
        <%# FUIME: dropped an `admin-bg-red` row highlight for
            Event::Plan::HackClubAffiliate — Hack Club's own organizations, whose
            plan class declares `selectable? false` and "Not a Fuime plan". No
            Fuime venture can be on it, so the branch only cost a plan load. %>
        <tr>
          <td><%= hcb_code.created_at.strftime("%Y-%m-%d") %></td>
          <td>
            <span style="display: flex; align-items: center; gap: 8px;">
              <%= avatar_for task.reviewer, class: "avatar" %>
              <%= task.reviewer&.name %>
            </span>
          </td>
          <td>
            <span style="display: flex; align-items: center; gap: 8px;">
              <%= avatar_for hcb_code.event.point_of_contact, class: "avatar" %>
              <%= hcb_code.event.point_of_contact&.name %>
            </span>
          </td>
          <td>
            <%= link_to hcb_code.memo, "#", data: hcb_code_popover_data(hcb_code) %>
          </td>
          <td>
            <%= render_money hcb_code.amount_cents %>
          </td>
          <td>
            <%= hcb_code.receipts.count %>
          </td>
          <td>
            <%= link_to "Review", admin_ledger_audits_task_path(task), class: "btn" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @tasks %>

  <style>
    form, input {
      margin-bottom: 0px!important;
    }

    h3 {
      margin-top: 0px;
      margin-bottom: 16px;
    }

    hr {
      display: none;
    }

    .avatar {
      margin-bottom: 0px;
    }
  </style>
</div>
