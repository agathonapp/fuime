<% title "Transaction #{@canonical_transaction.id}" %>

<h1>Transaction <%= @canonical_transaction.id %></h1>

<table class="no-stripes <%= "admin-bg-pending" unless @canonical_transaction.canonical_event_mapping %>">
  <tbody>
    <tr>
      <th>ID</th>
      <td><%= link_to @canonical_transaction.id, canonical_transaction_path(@canonical_transaction) %></td>
    </tr>
    <tr>
      <th>Date</th>
      <td><%= @canonical_transaction.date %></td>
    </tr>
    <tr>
      <th>Memo</th>
      <td><%= @canonical_transaction.memo %></td>
    </tr>
    <tr>
      <%# FUIME: not "Bank account" — there is no bank feed. This is the
          transaction_source: FUIMECONNECT (settled Stripe sales), FUIMEINTERNAL,
          FUIMEPLAYGROUND, or Stripe Issuing. %>
      <th>Source</th>
      <td><%= @canonical_transaction.bank_account_name %></td>
    </tr>
    <tr>
      <th>FriendlyMemo</th>
      <td><%= @canonical_transaction.friendly_memo %></td>
    </tr>
    <tr>
      <th>CustomMemo</th>
      <td><%= @canonical_transaction.custom_memo %></td>
    </tr>
    <tr>
      <th>Amount</th>
      <td><%= @canonical_transaction.amount.format %></td>
    </tr>
    <tr>
      <th>Fuime Code</th>
      <td><%= link_to @canonical_transaction.hcb_code, hcb_code_path(@canonical_transaction.local_hcb_code) %></td>
    </tr>
    <%# FUIME: a settled Fuime line carries its ledger key on the end of the memo
        (Fuime::VentureLedger.settled_memo), so the Stripe object it came from is
        one hop away. Absent for Playground Mode and school-funded lines. %>
    <% if (stripe_url = fuime_stripe_dashboard_url(@canonical_transaction.memo)) %>
      <tr>
        <th>Stripe</th>
        <td><%= link_to stripe_url, stripe_url, target: "_blank", rel: "noopener" %></td>
      </tr>
    <% end %>
    <tr>
      <th>MappedBy</th>
      <td><%= @canonical_transaction.canonical_event_mapping.try(:user).try(:email) %></td>
    </tr>
    <tr>
      <th>Category</th>
      <td>
        <%= render(
              partial: "hcb_codes/transaction_category_form",
              locals: { model: @canonical_transaction, admin_context: true }
            ) %>
      </td>
    </tr>
  </tbody>
</table>

<%# FUIME-DISABLED: Wise is outbound international transfer, one of the rails
    Fuime::DisabledModules turns off ("wise_transfers"). The block below keys off
    a "WISE INC" memo arriving on a bank feed Fuime does not have, so it can
    never render; admin_controller#transaction no longer computes it. %>
<% if @suggested_wise_mapping %>
  <div class="border-[#9FE870] border-solid border-1 p-5 my-6">
    <h3 class="mt-0 pt-0 mb-4">Suggested Wise mapping</h3>

    <p class="flex flex-row items-center gap-2">
      <%= badge_for(@suggested_wise_mapping.state_text, class: "ml-0 bg-#{@suggested_wise_mapping.status_color}") %>
      <%= @suggested_wise_mapping.admin_dropdown_description %>
    </p>

    <p>Sent at <%= format_datetime @suggested_wise_mapping.sent_at %></p>

    <%= form_with model: false, local: true, url: set_wise_transfer_path(@canonical_transaction), class: "mb-0", method: :post do |form| %>
      <%= form.hidden_field :wise_transfer_id, value: @suggested_wise_mapping.id %>
      <%= form.submit "Map to Wise transfer ##{@suggested_wise_mapping.id}", data: { "turbo-confirm": "Are you sure you want to map this transaction to Wise transfer ##{@suggested_wise_mapping.id}?" }, class: "!mb-0 mt-3" %>
      <%= link_to "View Wise transfer ##{@suggested_wise_mapping.id}", wise_transfer_process_admin_path(@suggested_wise_mapping), class: "ml-2", target: "_blank" %>
    <% end %>
  </div>
<% end %>

<table>
  <thead>
    <tr>
      <%# FUIME-DISABLED: removed the "Map to a Wire" and "Map to a Wise transfer"
          columns. Both controllers are refused by Fuime::DisabledModules
          ("wires", "wise_transfers"), so Wire.approved and WiseTransfer.sent are
          permanently empty — the cells rendered an empty select and a Set button
          that could only ever no-op. Mapping to an event is the one real action
          on this page. set_wire_path / set_wise_transfer_path are untouched. %>
      <th>Map to an Event</th>
    </tr>
  </thead>
  <tbody>
    <tr class="<%= "admin-bg-pending" unless @canonical_transaction.canonical_event_mapping %>">
      <td>
        <div class="flex flex-row gap-2">
          <%= form_with model: false, local: true, url: set_event_path(@canonical_transaction), method: :post do |form| %>
            <%= combobox_tag :event_id, event_search_admin_index_path, placeholder: "Select event", class: "!max-w-full !min-w-72", value: @canonical_transaction.event&.to_combobox_display %>
            <%= form.submit "Set", data: { "turbo-confirm": @mapping_confirm_msg } %>
          <% end %>
        </div>
        <%= form_with url: set_event_path(@canonical_transaction), method: :post do |form| %>
          <%= form.hidden_field :event_id, value: EventMappingEngine::EventIds::NOEVENT %>
          <%= form.submit "Map to NoEvent", data: { turbo_confirm: @canonical_transaction.local_hcb_code.unknown? ? "Hey there– you sure you want to map this transaction to NoEvent?" : "Woaaahaa! 😯 This seems like a transaction that SHOULD NOT be manually mapped! Are you sure you want to do this? 👀" }, class: "my-0" %>
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<br><hr>

<% if @canonical_transaction.canonical_event_mapping %>
  <h4>Receipts</h4>

  <% @hcb_code = @canonical_transaction.local_hcb_code %>
  <div style="margin-left: -2rem;" class="mt2">
    <%= render "receipts/list_v2", hcb_code: @hcb_code %>
  </div>

  <div style="width: 250px;">
    <%= render partial: "receipts/form_v3", locals: {
          receiptable: @canonical_transaction.local_hcb_code,
          upload_method: "attach_receipt_page",
          turbo: false,
          redirect_url: ledger_admin_index_path
        } %>
  </div>
<% end %>

<h4 class="mb2">Comments</h4>

<% @hcb_code.comments.each do | comment | %>
  <p class="mb1">
    <b>
      <%= comment.user.name %> <%= comment.action_text %> <%= time_ago_in_words comment.created_at %> ago
    </b>
  </p>
  <% if comment.content.blank? %>
    <div class="muted mb1"><em>Comment left blank.</em></div>
  <% else %>
    <%= MarkdownService.instance.render(comment.content, current_user:, record: comment) %>
  <% end %>
  <% if comment.has_attached_file? %>
    <p>
      <%= link_to "📎 attachment", url_for(comment.file), target: "_blank" %>
    </p>
  <% end %>
<% end %>

<%# FUIME-DISABLED: DonationPayout belongs to HCB's nonprofit money-in, which
    is off (see nav.rb's Incoming Money section). admin_controller#transaction no
    longer queries it, so this stays permanently hidden rather than being
    deleted. %>
<% if @potential_donation_payouts.present? %>
  <h4>Potential DonationPayouts to Map to</h4>

  <table>
    <tbody>
      <% @potential_donation_payouts.each do |pdp| %>
        <tr>
          <td><%= pdp.id %></td>
          <td><%= pdp.statement_descriptor %></td>
          <td><%= render_money pdp.amount %></td>
          <td><%= link_to pdp.event.admin_formatted_name, pdp.event %></td>
          <td><%= link_to "stripe #{pdp.stripe_payout_id}", "https://dashboard.stripe.com/payouts/#{pdp.stripe_payout_id}" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br><hr>
<% end %>

<% if @potential_invoice_payouts.present? %>
  <h4>Potential InvoicePayouts to Map to</h4>

  <table>
    <tbody>
      <% @potential_invoice_payouts.each do |pdp| %>
        <tr>
          <td><%= pdp.id %></td>
          <td><%= pdp.statement_descriptor %></td>
          <td><%= render_money pdp.amount %></td>
          <td><%= link_to pdp.event.admin_formatted_name, pdp.event %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br><hr>
<% end %>

<% if @canonical_pending_transactions.present? %>
  <h4>Potential Pending Transactions to Map to</h4>

  <table>
    <tbody>
      <% @canonical_pending_transactions.each do |cpt| %>
        <tr>
          <td><%= cpt.id %></td>
          <td><%= cpt.date %></td>
          <td><%= cpt.memo %></td>
          <td><%= cpt.amount %></td>
          <%# FUIME: @canonical_pending_transactions is CanonicalPendingTransaction.unmapped,
              so cpt.event is nil by definition and `cpt.event.name` raised
              NoMethodError the moment any unmapped pending row matched this
              transaction's amount. %>
          <td><%= link_to cpt.event.name, cpt.event if cpt.event %></td>
          <td><%= link_to "Linked Object", cpt.linked_object if cpt.linked_object %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <br><hr>
<% end %>

<h4>Journey</h4>

<p>CanonicalTransaction</p>
<%= sanitize(ap(@canonical_transaction), attributes: %w(style)) %>
<p>↓</p>

<p><%= @canonical_transaction.transaction_source_type %></p>
<%= sanitize(ap(@canonical_transaction.transaction_source), attributes: %w(style)) %>

<br><hr>

<h4>System Events</h4>

<% @ahoy_events.each do |ae| %>
  <p><%= ae.name %> <small><%= ae.time %></small></p>
  <%= sanitize(ap(ae.properties), attributes: %w(style)) %>
<% end %>

<br><hr>
