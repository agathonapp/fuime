<% title "Add a Raw Transaction" %>

<h1>Add a Raw Transaction By Hand</h1>

<%= form_with(model: false, local: true, url: raw_transaction_create_admin_index_path) do |form| %>
  <fieldset>
    <legend>Raw Transaction</legend>
    <p>
      <%# FUIME: "Bank Identifier" defaulting to FSMAIN was HCB's SVB operating
          account, and the options came off HashedTransaction (every raw source,
          including ones no RawCsvTransaction can have). Both are wrong here:
          this form writes a RawCsvTransaction, and Fuime's only pseudo-accounts
          are FUIMECONNECT / FUIMEINTERNAL / FUIMEPLAYGROUND. %>
      <%= form.label :unique_bank_identifier, "Source" %>
      <br>
      <%= form.collection_select(:unique_bank_identifier, RawCsvTransaction.distinct.where.not(unique_bank_identifier: nil).order("unique_bank_identifier asc").pluck(:unique_bank_identifier), :to_s, :to_s, { selected: "FUIMEINTERNAL", include_blank: true }, {}) %>
    </p>

    <p>
      <%= form.label :date, "Date" %>
      <br>
      <%= form.text_field :date, placeholder: "2021-03-01", required: true %>
    </p>

    <p>
      <%= form.label :memo %>
      <br>
      <%= form.text_field :memo, placeholder: "Transaction memo", required: true %>
    </p>

    <p>
      <%= form.label :amount, "Amount" %>
      <br>
      <span class="bold muted" style="width: 1rem;">$</span>
      <%= form.number_field :amount, placeholder: "500.00", step: 0.01, required: true %>
    </p>
  </fieldset>

  <p>
    <%= form.submit "Add raw transaction" %>
  </p>
<% end %>
