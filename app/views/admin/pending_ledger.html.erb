<% title "Pending Ledger" %>

<%= form_with local: true, class: "card overflow-visible", url: pending_ledger_admin_index_path, method: :get do |form| %>
    <div class="flex flex-col sm:flex-row items-center gap-2">
        <%= render "events/filters/search", form: %>
        <%= combobox_tag :event_id, event_search_admin_index_path, placeholder: "Event", class: "!max-w-full !min-w-full sm:!min-w-72", value: @event&.to_combobox_display %>
    </div>
    <div class="flex items-center mt-2 gap-4 flex-wrap">
        <%= form.label :unsettled do %>
            <%= form.check_box :unsettled, checked: @unsettled %> Unsettled
        <% end %>
        <%= form.submit "Search", class: "ml-auto" %>
    </div>
<% end %>

<div class="flex items-center mb2 flex-col sm:flex-row">
  <div class="flex-grow">
    <%= page_entries_info @canonical_pending_transactions, entry_name: "transactions" %>
  </div>
  <%= paginate @canonical_pending_transactions %>
</div>

<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Date</th>
      <th>Memo</th>
      <th>Amount</th>
      <th>Fuime Code</th>
      <th>Event</th>
      <th>Category</th>
      <%# FUIME: was "Actions", rendering an empty cell on every row — its two
          links (Process / View, into admin#transaction) had been ERB-commented
          upstream because that action loads a CanonicalTransaction and a pending
          row has none. Replaced with the one action that is real here: the Stripe
          object this pending line was written from. %>
      <th>Stripe</th>
    </tr>
  </thead>
  <tbody>
    <% @canonical_pending_transactions.each do |cpt| %>
      <tr class="<%= "admin-bg-pending" if cpt.unsettled? %>">
        <td><%= cpt.id %></td>
        <td>
          <%= cpt.date %>
          <% if cpt.pending_expired? %>
            <span>⚠️ (Overdue)</span>
          <% end %>
        </td>
        <td>
          <% if cpt.event %>
            <%= link_to cpt.memo, cpt.local_hcb_code %>
          <% else %>
            <%= cpt.memo %>
          <% end %>
        </td>
        <td><%= cpt.amount %></td>
        <td><%= cpt.local_hcb_code ? link_to(cpt.hcb_code, hcb_code_path(cpt.local_hcb_code)) : cpt.hcb_code %></td>
        <td><%= link_to cpt.event.id, cpt.event if cpt.event %></td>
        <td>
          <%= render(
                partial: "hcb_codes/transaction_category_form",
                locals: { model: cpt, admin_context: true }
              ) %>
        </td>
        <td>
          <%# FUIME: every Fuime money-in line is a RawPendingDonationTransaction
              whose donation_transaction_id is the ledger key — "fuime_<pi_…>" for
              the sale, "fuime_fee_<pi_…>" for Fuime's cut. nil for Playground
              Mode and school-funded lines, which have no Stripe object. %>
          <% if (stripe_url = fuime_stripe_dashboard_url(cpt.raw_pending_donation_transaction&.donation_transaction_id)) %>
            <%= link_to "Stripe", stripe_url, target: "_blank", rel: "noopener" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @canonical_pending_transactions %>
