<%# Absolute URL required: link previews are fetched by other servers, which
    can't resolve a relative path. Still the bare logo rather than a designed
    1200x630 card — worth replacing before a real launch push. %>
<% img = "#{root_url.chomp('/')}/brand/fuime-social.png" %>
<% description = "Fuime is the financial platform for teen-run businesses: a real account, payments, receipts, and automatic tax tracking — with a parent or guardian as the legal signer." %>
<meta name="description" content="<%= description %>">
<meta property="og:site_name" content="Fuime">
<meta property="og:url" content="<%= root_url %>">
<meta property="og:title" content="Fuime — the financial home for teen businesses">
<meta property="og:description" content="<%= description %>">
<meta property="og:image" content="<%= img %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Fuime — the financial home for teen businesses">
<meta name="twitter:description" content="<%= description %>">
<meta name="twitter:image" content="<%= img %>">
