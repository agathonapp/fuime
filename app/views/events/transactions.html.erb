<% if organizer_signed_in? %>
  <%= turbo_stream_from @event, :transactions %>
  <%= turbo_stream_from @event, :tags %>
  <% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% end %>

<% if @event&.is_public %>
  <% auto_discover_feed(@event) %>
  <% content_for :head do %>
    <% img = "https://hcb-og.hackclub.com/api/embeds/#{@event.slug}" %>
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <meta property="og:image" content="<%= img %>">
    <meta name="twitter:image" content="<%= img %>">
    <meta property="og:site_name" content="Fuime">
    <meta property="og:url" content="<%= event_url(@event) %>">
    <meta property="og:title" content="<%= @event.name %>">
    <meta name="twitter:title" content="<%= @event.name %>">
    <% description = "#{@event.name}'s finances have been made public on Fuime so you can see how their money is spent." %>
    <meta property="og:description" content="<%= description %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="description" content="<%= description %>">
  <% end %>
<% end %>

<% title "Transactions for #{@event.name}" %>

<%= render "events/nav", selected: :transactions %>

<%# The anchor the Playground Mode banner links to. Restored from upstream
    (73d010de6) with Fuime's wording — the original invited teams to explore a
    fiscal-sponsorship dashboard. %>
<% if organizer_signed_in? && @event.demo_mode? %>
  <div class="card border b--info pb0 mb-4" style="text-wrap: pretty;" id="playground-callout" data-tour-step="playground_mode">
    <p class="mt0">
      <strong>Welcome to Playground Mode</strong>
      <br>
      Nothing here moves real money. Turn on mock data from the banner above to
      see what a busy month looks like, or invite your team and click around.
    </p>
  </div>
<% end %>

<%= render "events/heading", event: @event, event_follow: @event_follow, show_ledger_toggle: true do %>
  <span class="flex-grow">Transactions</span>
<% end %>

<div class="statset mb-2">
  <div class="stat">
    <span class="stat__label">Owed to you</span>
    <%# Fuime: read through Fuime::PayablesLedger so this agrees with the payouts
        page. `balance_available_v2_cents` subtracts HCB's accrued fee_balance,
        and Fuime's fee is already deducted by Stripe at the charge — see
        FeeEngine::Create. %>
    <%# this event has a fee credit (owes negative fees) %>
    <% if @event.fee_balance_v2_cents < 0 %>
      <span class="stat__value stat__value--no-space"><%= render_money_amount payables_for(@event).net_payable_cents %></span>
      <span class="self-end" style="font-size: 10px;">
        +$<%= render_money_amount @event.fee_balance_v2_cents.abs %> fee credit
      </span>
    <% else %>
      <span class="stat__value stat__value--no-space">
        <%= render_money_amount(payables_for(@event).net_payable_cents) %>
      </span>
    <% end %>
  </div>

  <div class="stat stat--small">
    <span class="stat__label">Total revenue</span>
    <span class="stat__value stat__value--no-space">
      <%= render_money_amount(@event.total_raised) %>
    </span>
  </div>

  <div class="stat stat--small">
    <span class="stat__label">Total expenses</span>
    <span class="stat__value stat__value--no-space">
      <%= render_money_amount(@event.total_spent_cents) %>
    </span>
  </div>
</div>

<%= render "events/public_message" %>
<main data-controller="transactions" class="mt-2">
  <%= render "events/pinned_transactions" %>
  <%= turbo_frame_tag [dom_id(@event), :ledger], src: event_transactions_list_path(@event, request.query_parameters) do %>
    <%= render "application/loading_container", klass: "mt-8" %>
  <% end %>
</main>
