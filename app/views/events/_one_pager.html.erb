<%# locals: (title:, support_article: nil, screenshots: nil, hints:) %>
<%#
  Fuime: `screenshots` and `support_article` are now optional.

  Every caller passed screenshots of hcb.hackclub.com hosted on
  cdn.hackclub.com / user-cdn.hackclub-assets.com, and support_article links
  into help.hcb.hackclub.com. On an empty-state page that meant a Fuime user
  was shown a picture of a different product and sent to another company's
  help centre — including on Invoices, which is Fuime's own money-in feature.

  The screenshot column and the "Learn more in our help center" link are now
  omitted when absent, and the copy column widens to fill the row. Repoint
  these at Fuime's own screenshots and docs when they exist.
%>
<% has_screenshots = screenshots.present? && screenshots[:light].present? %>

<div class="grid grid-cols-1 <%= "sm:grid-cols-5" if has_screenshots %> min-h-[calc(100vh-60px)] gap-4 sm:gap-20 px-3">
  <div class="flex flex-col justify-center <%= has_screenshots ? "col-span-2" : "max-w-2xl mx-auto w-full" %>">
    <h1 class="heading border-0 mb-0">
      <%= title %>
    </h1>
    <% if support_article.present? %>
      <%= link_to support_article, target: "_blank", class: "-mt-1 mb-2 no-underline inline-flex items-center gap-1" do %>
        Learn more in our help center
        <%= inline_icon "external", size: 24 %>
      <% end %>
    <% end %>

    <div class="-mx-4 mb-2">
      <% hints.each do |point| %>
        <div class="btn btn--list-item pointer-events-none items-start">
          <%= inline_icon point[:icon], class: "mt-1" %>
          <div>
            <strong><%= point[:title] %></strong>
            <p class="text-sm opacity-60"><%= point[:description] %></p>
          </div>
        </div>
      <% end %>
    </div>
    <%= yield %>
  </div>
  <% if has_screenshots %>
    <div class="col-span-3 flex items-center justify-center">
      <div class="card p-0 card--breakdown">
        <img src="<%= screenshots[:light] %>" alt="Illustration" class="w-full h-auto dark:hidden">
        <img src="<%= screenshots[:dark] %>" alt="Illustration" class="w-full h-auto hidden dark:block">
        <% if content_for?(:caption) %>
          <div class="p-2 pt-0 text-center">
            <%= yield(:caption) %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
