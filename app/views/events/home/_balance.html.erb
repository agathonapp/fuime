<div class="card card--breakdown p-0 flex-1 flex flex-col" style="pointer-events: none;" data-controller="balance-graph" data-balance-graph-available-value="<%= payables_for(@event).net_payable_cents %>" data-balance-graph-slug-value="<%= @event.slug %>">
  <h3 data-balance-graph-target="label" class="m-0 p-4 pb-0 mb-2" style="margin-bottom: -4px">Owed to you</h3>
  <div
    class="flex flex-grow flex-col"
    style="gap: 8px;position: relative;">
    <div class="p-4 pt-2 flex flex-col">
      <div data-balance-graph-target="stat" data-tour-step="balance">
        <% if @event.fee_balance_v2_cents < 0
             # this event has a fee credit (owes negative fees) %>
          <span class="stat__value tabular-nums !text-4xl lg:!text-5xl" data-balance-graph-target="balance"><%= render_money payables_for(@event).net_payable_cents %></span>
          <span class="self-end tabular-nums" style="font-size: 10px;">+$<%= render_money_amount @event.fee_balance_v2_cents.abs %> fee credit</span>
        <% else %>
          <span class="stat__value tracking-tight tabular-nums !text-4xl lg:!text-5xl" data-balance-graph-target="balance">
            <%= render_money(show_mock_data? && @mock_total ? @mock_total : payables_for(@event).net_payable_cents) %>
          </span>
        <% end %>
      </div>

      <div data-nosnippet class="hidden" aria-hidden="true" class="" data-tour-step="balance" data-balance-graph-target="size">
        <span class="stat__label">&nbsp;</span>
        <% if @event.fee_balance_v2_cents < 0
             # this event has a fee credit (owes negative fees) %>
          <span class="stat__value tracking-tight tabular-nums" data-balance-graph-target="sizing"><%= render_money payables_for(@event).net_payable_cents %></span>
          <span class="self-end" style="font-size: 10px;">+$<%= render_money_amount @event.fee_balance_v2_cents.abs %> fee credit</span>
        <% else %>
          <span class="stat__value tracking-tight tabular-nums" data-balance-graph-target="sizing">
            <%= render_money(show_mock_data? && @mock_total ? @mock_total : payables_for(@event).net_payable_cents) %>
          </span>
        <% end %>
      </div>

      <%# Fuime: money taken but not yet released, said HERE and not only on the
          payouts page.

          "Owed to you" is `net_payable_cents`, which is settled lines only —
          correct, because Fuime posts incoming money `fronted: false` and has no
          reserves to advance against it (Fuime::VentureLedger#post!). But it
          meant a founder who had just been paid saw this number not move, on the
          one screen they actually look at, and concluded the payment had failed.
          The figure already existed; it was rendered on /payouts and nowhere else.

          Deliberately NOT added to the number above, and phrased as a separate
          sentence, for the reason spelled out in fuime/payouts/index.html.erb:
          money Stripe has taken and not released is coming, not owed today, and
          merging the two is how a reader concludes Fuime is holding a balance for
          them — which is the product Fuime may not offer (L1/L5). %>
      <% pending_sales = payables_for(@event).pending_sales_cents %>
      <% if pending_sales.positive? %>
        <p class="muted text-sm mt-1 mb-0">
          <%= render_money(pending_sales) %> more from recent sales — Stripe
          usually releases it within a couple of days.
        </p>
      <% end %>
    </div>
    <div class="flex-grow"></div>
    <div style="height: <%= (@recent_transactions.size - 1) * 60 %>px;z-index:1">
      <svg data-balance-graph-target="graph" id="balance-chart" class="sparkline sparkline--filled w-full absolute" style="bottom: -2px; left: -4px;width: calc(100% + 8px)" height="300" stroke-width="4"></svg>
    </div>
  </div>
</div>
