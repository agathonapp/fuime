<%= turbo_frame_tag "event_stats" do %>
  <div class="statset mb-2">
    <%# Fuime: "Owed to you", not "Account balance". Fuime LLC is the seller of
        record, so this is an amount Fuime owes on a stated date — a receivable —
        and not a balance held on deposit. The distinction is legal, not cosmetic
        (CLAUDE.md L1/L5); see Fuime::PayablesLedger.

        Reads the presenter rather than Event#balance_available_v2_cents so this
        agrees with the payouts page. Those two used to differ, because
        `balance_available` subtracts HCB's accrued fee_balance and Fuime's fee is
        already deducted by Stripe at the charge — see FeeEngine::Create. %>
    <div class="stat">
      <span class="stat__label">Owed to you</span>
      <%# this event has a fee credit (owes negative fees) %>
      <% if @event.fee_balance_v2_cents < 0 %>
        <span class="stat__value stat__value--no-space"><%= render_money_amount payables_for(@event).net_payable_cents %></span>
        <span class="self-end" style="font-size: 10px;">+$<%= render_money_amount @event.fee_balance_v2_cents.abs %>
          fee credit</span>
      <% else %>
      <span class="stat__value stat__value--no-space">
        <%= render_money_amount(payables_for(@event).net_payable_cents) %>
      </span>
      <% end %>
    </div>

    <div class="stat stat--small">
      <span class="stat__label">Total revenue</span>
      <span class="stat__value stat__value--no-space">
        <%= render_money_amount(@event.total_raised) %>
      </span>
    </div>

    <div class="stat stat--small">
      <span class="stat__label">Total expenses</span>
      <span class="stat__value stat__value--no-space">
        <%= render_money_amount(@event.total_spent_cents) %>
      </span>
    </div>
  </div>
<% end %>
