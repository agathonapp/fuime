<% title "#{@event.name} | Fuime" %>

<% content_for :head do %>
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta property="og:site_name" content="Fuime">
  <meta property="og:url" content="<%= fuime_storefront_url(@event.slug) %>">
  <meta property="og:title" content="<%= @event.name %> on Fuime">
  <meta name="twitter:title" content="<%= @event.name %> on Fuime">
  <% description = "#{@event.name} is a teen business on Fuime — the financial platform for young entrepreneurs. #{@event.storefront_tagline.presence || 'View their public ledger and support their business.'}" %>
  <meta property="og:description" content="<%= description %>">
  <meta name="twitter:description" content="<%= description %>">
  <meta name="description" content="<%= description %>">
<% end %>

<div class="max-w-3xl mx-auto py-8 px-4">
  <%# Header %>
  <div class="text-center mb-8">
    <% if @event.logo.attached? %>
      <%= image_tag @event.logo, class: "w-24 h-24 rounded-full mx-auto mb-4 object-cover", alt: @event.name %>
    <% else %>
      <div class="w-24 h-24 rounded-full mx-auto mb-4 bg-primary flex items-center justify-center">
        <span class="text-white text-3xl font-bold"><%= @event.name.first.upcase %></span>
      </div>
    <% end %>

    <h1 class="text-3xl font-bold mb-2"><%= @event.name %></h1>

    <% if @event.storefront_tagline.present? %>
      <p class="text-lg muted mb-4"><%= @event.storefront_tagline %></p>
    <% end %>

    <%# Official badge %>
    <div class="flex items-center justify-center gap-2 flex-wrap">
      <span class="badge bg-success text-white px-3 py-1.5 rounded-full flex items-center gap-1">
        <%= inline_icon "check-circle", size: 16 %>
        Official on Fuime
      </span>
      <%# Fuime: this claims only what we can actually evidence. Accepting a
          guardian invite currently proves control of an email address and a
          self-asserted date of birth — NOT a verified parental relationship.
          Restore the stronger "Parent-signed account" wording once guardian
          identity verification ships (PRODUCTION_READINESS.md §1.2). %>
      <% if @has_guardian %>
        <span class="badge bg-primary text-white px-3 py-1.5 rounded-full flex items-center gap-1"
              title="A parent or guardian has accepted responsibility for this account on Fuime.">
          <%= inline_icon "people-2", size: 16 %>
          Guardian on account
        </span>
      <% end %>
      <% if @event.business_category.present? %>
        <span class="badge bg-muted text-dark px-3 py-1.5 rounded-full">
          <%= @event.business_category.titleize %>
        </span>
      <% end %>
    </div>
  </div>

  <%# Payment %>
  <div class="card text-center mb-6 bg-snow">
    <% if params[:paid].present? %>
      <div class="badge bg-success text-white px-3 py-1.5 rounded-full mb-3 inline-flex items-center gap-1">
        <%= inline_icon "checkmark", size: 16 %>
        Payment received
      </div>
      <p class="muted m-0">Thank you for supporting <%= @event.name %>.</p>
      <p class="text-sm muted mt-2">
        <% if StripeService.live? %>
          It'll appear on <%= @event.name %>'s ledger once Stripe confirms it.
        <% else %>
          That was a <strong>test payment</strong> — no real money changed hands.
          It'll appear on <%= @event.name %>'s ledger once Stripe confirms it.
        <% end %>
      </p>
    <% else %>
      <%# Fuime: this form talks to whichever Stripe mode the deployment is in.
          In test mode a customer entering a real card is declined — so
          rendering a plain "Pay" button would be a promise the page cannot
          keep, on a public URL a teenager has shared with actual customers.
          The form stays functional, because the beta and every demo need it;
          it just stops pretending. %>
      <% stripe_live = StripeService.live? %>
      <h3 class="m-0 mb-2">
        <%= stripe_live ? "Support this business" : "Payments aren't live yet" %>
      </h3>
      <% if stripe_live %>
        <p class="muted m-0 mb-4">Make a payment directly to <%= @event.name %></p>
      <% else %>
        <p class="muted m-0 mb-4">
          <%= @event.name %> is on Fuime while we're still in beta. You can try
          the checkout below, but it runs in Stripe's test mode —
          <strong>a real card will not be charged.</strong>
        </p>
      <% end %>

      <%# Fuime: a venture can only be paid once its guardian has completed Stripe
          setup — there is otherwise no account for the money to land in, and the
          checkout endpoint refuses. Rendering the form anyway would put a dead
          "Pay" button on a public URL a teenager has shared with real customers,
          which is the same class of mistake as the pre-launch copy above. %>
      <%# ── What this business sells ────────────────────────────────────────
          The operator's own offers, at the operator's own prices, in the
          operator's own order. Nothing here is ranked, scored or recommended by
          Fuime, and no price on this page was written by Fuime — see
          Fuime::Offer and §8.3 D2.

          Rendered above the free-amount form because for a business that has
          listed anything, this IS the storefront; the amount box below is the
          fallback for a customer who was quoted a price in person. %>
      <% if @offers.any? %>
        <div class="flex flex-col gap-3 mb-6 mx-auto" style="max-width: 28rem;">
          <% @offers.each do |offer| %>
            <div class="card card--outline text-left">
              <div class="flex items-start justify-between gap-3 flex-wrap">
                <div>
                  <strong><%= offer.name %></strong>
                  <div class="muted"><%= offer.price_sentence %></div>
                </div>
                <% if @accepts_payments %>
                  <%= button_to "Buy", fuime_storefront_pay_path(slug: @event.slug),
                                method: :post,
                                params: { offer_token: offer.to_param },
                                class: "btn #{stripe_live ? 'btn--primary' : 'bg-muted'}" %>
                <% end %>
              </div>
              <% if offer.description.present? %>
                <p class="text-sm muted mt-2 mb-0"><%= offer.description %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if @accepts_payments %>
        <%= form_with url: fuime_storefront_pay_path(slug: @event.slug), method: :post,
                      class: "flex flex-col items-center gap-3" do |form| %>
          <div class="field w-full" style="max-width: 20rem;">
            <%= form.label :amount, @offers.any? ? "Or pay another amount (USD)" : "Amount (USD)", class: "text-left block" %>
            <%= form.text_field :amount, placeholder: "25.00", inputmode: "decimal",
                                required: true, class: "w-full" %>
          </div>
          <div class="field w-full" style="max-width: 20rem;">
            <%= form.label :description, "What's this for?", class: "text-left block" %>
            <%= form.text_field :description, placeholder: "Custom print",
                                              class: "w-full" %>
          </div>
          <%= form.submit stripe_live ? "Pay #{@event.name}" : "Try a test payment",
                          class: "btn btn--lg #{stripe_live ? 'btn--primary' : 'bg-muted'}" %>
        <% end %>

        <p class="text-sm muted mt-3 m-0">
          Secure checkout by Stripe.
          <%# Reads the venture's plan rather than a constant: the hardcoded 4%
              this replaced ignored the plan entirely, so a Founders-plan venture
              advertised a fee it does not pay. %>
          Fuime keeps
          <%= number_to_percentage(@event.revenue_fee * 100, precision: 1) %>
          to run the platform.
        </p>
      <% else %>
        <%# Fuime: two reasons, and only one of them is safe to state.

            #accepts_payments? is now false either because the guardian has not
            finished Stripe setup OR because Fuime has not approved this operator
            to sell (Fuime::OperatorEligibility). The first is a normal,
            non-damaging fact the customer can act on — check back later. The
            second is a decision about a child's business on a page anyone can
            load, and "this venture is suspended" is both reputationally harmful
            and nobody's business but the operator's, their guardian's and
            Fuime's.

            So the reason is named only when it is the harmless one. The operator
            sees the real blockers on their own authenticated pages. Never render
            Event#selling_blockers here — those strings state children's ages. %>
        <p class="muted m-0">
          <% if @event.payment_account&.ready_for_payments? %>
            <strong><%= @event.name %> isn't taking payments right now.</strong>
            Please check back soon.
          <% else %>
            <strong><%= @event.name %> isn't set up to take payments yet.</strong>
            A parent or guardian still needs to finish setting up the account money
            is paid into. Please check back soon.
          <% end %>
        </p>
      <% end %>
      <% unless stripe_live %>
        <p class="text-sm mt-1 m-0">
          Test card <strong>4242 4242 4242 4242</strong>, any future expiry,
          any CVC.
        </p>
      <% end %>
    <% end %>
  </div>

  <%# Business stats %>
  <div class="card mb-6">
    <h3 class="m-0 mb-4">Business Overview</h3>
    <%# Fuime: the account balance of a child's business is NOT published.
        Fuime shows it because its orgs are nonprofits publishing accountability
        data; here it would tell the internet how much money a named teenager
        has. Same reasoning for the owner's name, shown only for adult owners. %>
    <div class="grid grid-cols-2 gap-4">
      <div class="p-3 bg-snow rounded-lg text-center">
        <p class="muted m-0 mb-1 text-sm">On Fuime since</p>
        <p class="m-0 text-xl font-bold"><%= @event.created_at.strftime("%b %Y") %></p>
      </div>
      <div class="p-3 bg-snow rounded-lg text-center">
        <p class="muted m-0 mb-1 text-sm">Status</p>
        <p class="m-0 text-xl font-bold"><%= @has_guardian ? "Parent-signed" : "Active" %></p>
      </div>
      <% if @show_owner_name %>
        <div class="p-3 bg-snow rounded-lg text-center">
          <p class="muted m-0 mb-1 text-sm">Owner</p>
          <p class="m-0 text-xl font-bold"><%= @owner.first_name %></p>
        </div>
      <% end %>
    </div>
  </div>

  <%# About section %>
  <% if @event.public_message.present? %>
    <div class="card mb-6">
      <h3 class="m-0 mb-4">About</h3>
      <div class="prose">
        <%= MarkdownService.instance.render(@event.public_message) %>
      </div>
    </div>
  <% end %>

  <%# Public ledger teaser %>
  <div class="card mb-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="m-0">Public Ledger</h3>
      <%= link_to event_path(@event), class: "flex items-center shrink-0 no-underline text-sm" do %>
        View full ledger
        <%= inline_icon "view-forward", size: 16 %>
      <% end %>
    </div>
    <p class="muted m-0">
      This business's finances are transparent. You can view their complete transaction history
      and see exactly how funds are being used.
    </p>
  </div>

  <%# Footer %>
  <div class="text-center pt-8 border-t">
    <p class="muted text-sm">
      <%= @event.name %> is a teen-run business powered by
      <%= link_to "Fuime", root_path, class: "text-primary" %> —
      the financial platform for young entrepreneurs.
    </p>
    <p class="muted text-sm mt-2">
      Fuime is forked from
<%# The upstream project's name is HCB. The brand sweep replaced "HCB" here
    too, leaving the public-facing "Fuime is forked from Fuime by Hack Club" —
    nonsense, and it stops the attribution naming what it attributes
    (CLAUDE.md Rule 7). %>
      <%= link_to "HCB by Hack Club", "https://hackclub.com/hcb", target: "_blank", class: "text-primary" %>
      (AGPL-3.0)
    </p>
    <%# The storefront takes the no-nav layout branch, which does not render
        application/_footer — so the legal links added there never reach this
        page. It is also the one page where a member of the public is asked for
        money, which makes it the page that most needs them. %>
    <p class="muted text-sm mt-2">
      <%= link_to "Terms", terms_path, class: "text-primary" %> ·
      <%= link_to "Privacy", privacy_path, class: "text-primary" %>
    </p>
    <%# Same reason the legal links are duplicated here: the standing status
        disclosure lives in application/_footer, which this layout branch never
        renders. A payer on this page is handing over a card number, so this is
        the surface where an unrebutted assumption of "bank" and "insured" does
        the most damage — 12 CFR 328.102(b)(3)(ii) makes the omission itself the
        violation. Keep this in sync with application/_footer. %>
    <p class="muted text-xs mt-3 mx-auto" style="max-width: 34rem;">
      Fuime is a financial technology company, not a bank. Fuime does not hold
      deposits and does not offer FDIC-insured products. Payments are processed
      by Stripe. This venture's account is owned by a parent or legal guardian.
    </p>
  </div>
</div>
