<% title "What you sell — #{@event.name}" %>

<%# FUIME: listing and management. Creating a new offer is a multi-screen
    wizard (see /offers/new). The one rule that still holds on this page:
    **nothing here suggests a price.** spec/controllers/fuime/offers_controller_spec.rb
    asserts it. %>

<div class="flex items-baseline justify-between gap-2 flex-wrap mb-4">
  <div>
    <h1 class="mt0 mb0">What you sell</h1>
    <p class="muted mb0">
      Each thing you list shows up on your storefront with a Buy button. You set the
      price — Fuime never sets it or suggests one.
    </p>
  </div>
  <% if @can_manage %>
    <%= link_to "Add something to sell", new_fuime_offer_path(event_slug: @event.slug),
                class: "btn bg-blue", id: "add" %>
  <% end %>
</div>

<% if @selling_blockers.any? %>
  <%= render "fuime/selling_blockers", event: @event,
                                       blockers: @selling_blockers,
                                       title: "You can't publish offers yet" %>
<% end %>

<div class="card mb2">
  <div class="flex items-center justify-between gap-2 flex-wrap">
    <h2 class="mt0 mb0 text-lg">Your storefront</h2>
    <%= link_to "View it", fuime_storefront_path(slug: @event.slug), class: "muted", target: "_blank", rel: "noopener" %>
  </div>
  <p class="muted text-sm mt-1 mb-0">
    <%= fuime_storefront_url(slug: @event.slug) %>
  </p>
  <% if @can_manage %>
    <details class="mt-2">
      <summary class="muted text-sm">Edit storefront</summary>
      <%= form_with url: fuime_storefront_settings_path(event_slug: @event.slug),
                    method: :patch, scope: :event, local: true, class: "mt-2" do |form| %>
        <div class="field">
          <%= form.label :storefront_tagline, "One line about your business" %>
          <%= form.text_field :storefront_tagline, value: @event.storefront_tagline,
                                                   class: "w-full max-w-full", maxlength: 140,
                                                   placeholder: "Lawn care in Santa Barbara, weekends and holidays" %>
        </div>
        <div class="field">
          <%= form.label :logo, "Logo (optional)" %>
          <%= form.file_field :logo, accept: "image/png,image/jpeg,image/webp" %>
        </div>
        <div class="field">
          <%= form.check_box :is_public, checked: @event.is_public %>
          <%= form.label :is_public, "Show my storefront publicly" %>
        </div>
        <%= form.submit "Save storefront" %>
      <% end %>
    </details>
  <% end %>
</div>

<% if @offers.empty? %>
  <p class="muted">
    Nothing listed yet. Your storefront still works — a customer can pay you any
    amount — but listing what you sell means they don't have to ask.
  </p>
<% else %>
  <table class="min-w-0">
    <thead>
      <tr>
        <th>What</th>
        <th>Price</th>
        <th>Status</th>
        <% if @can_manage %><th class="w-64">Actions</th><% end %>
      </tr>
    </thead>
    <tbody>
      <% @offers.each do |offer| %>
        <tr>
          <td>
            <strong><%= offer.name %></strong>
            <% if offer.description.present? %>
              <div class="muted"><%= offer.description %></div>
            <% end %>
          </td>
          <td>
            <%= offer.price_sentence %>
            <%# FUIME: an offer's price could not be changed at all. There was no
                edit route and no price form for a persisted offer — the only
                PATCH on this page submitted the slug — so the workaround was
                archive-and-recreate, which burns the URL: `assign_slug` dedupes
                against archived rows and the pay page scopes to published, so
                every flyer, QR code and bio link 404s.

                That is a wall in front of the most ordinary thing a running
                business does. Prices move with the season, with materials, with
                the founder getting better at the work — and a teenager told to
                delete the thing their customers already have the link to is
                being told to choose between the right price and their existing
                customers.

                Inline rather than a new screen, matching the "Change this link"
                form directly below it. The controller already accepted this:
                `offer_params` permits name, description and unit_label, and
                merges `price_cents` whenever the form carries a price — the form
                was simply never built. %>
            <% if @can_manage %>
              <details class="mt-1">
                <summary class="muted text-sm">Edit</summary>
                <%= form_with url: fuime_offer_path(event_slug: @event.slug, id: offer.id),
                              method: :patch, scope: :fuime_offer, local: true,
                              class: "mt-1" do |form| %>
                  <div class="field">
                    <%= form.label :name, "What it is" %>
                    <%= form.text_field :name, value: offer.name, required: true,
                                               class: "w-full max-w-full text-sm" %>
                  </div>
                  <div class="flex gap-1 flex-wrap">
                    <div class="field flex-1">
                      <%= form.label :price, "Price" %>
                      <%# No placeholder amount, for the same reason the wizard's
                          price step has none: a number Fuime puts in this box is
                          a Fuime-suggested rate for anyone who leaves it. %>
                      <%= form.text_field :price, required: true, inputmode: "decimal",
                                          placeholder: "$", class: "w-full max-w-full text-sm",
                                          value: offer.price_cents.present? ? format("%.2f", offer.price_cents / 100.0) : nil %>
                    </div>
                    <div class="field flex-1">
                      <%= form.label :unit_label, "Per what? (optional)" %>
                      <%= form.text_field :unit_label, value: offer.unit_label,
                                                       maxlength: Fuime::Offer::MAX_UNIT_LABEL_LENGTH,
                                                       class: "w-full max-w-full text-sm",
                                                       placeholder: unit_label_placeholder_for(@event) %>
                    </div>
                  </div>
                  <div class="field">
                    <%= form.label :description, "Description (optional)" %>
                    <%= form.text_field :description, value: offer.description,
                                                      class: "w-full max-w-full text-sm" %>
                  </div>
                  <%= form.submit "Save changes", class: "btn btn--sm" %>
                <% end %>
                <p class="muted text-sm mt-1 mb-0">
                  <%# Said because it is the question a founder actually has
                      before touching a live price: does the link survive, and
                      does anyone who already paid get re-billed. %>
                  Your pay link stays the same, and anyone who already paid keeps
                  what they paid. New customers see the new price.
                </p>
              </details>
            <% end %>
          </td>
          <td>
            <%= offer.published? ? "On your storefront" : "Draft" %>
            <% if offer.published? %>
              <%= render "fuime/offers/share_link", offer:, event: @event, show_qr: true %>
              <% if @can_manage %>
                <details class="mt-1">
                  <summary class="muted text-sm">Change this link</summary>
                  <%= form_with url: fuime_offer_path(event_slug: @event.slug, id: offer.id),
                                method: :patch, scope: :fuime_offer, local: true,
                                class: "flex items-center gap-1 mt-1 flex-wrap" do |form| %>
                    <span class="muted text-sm">/pay/<%= @event.slug %>/</span>
                    <%= form.text_field :slug, value: offer.slug,
                                               maxlength: Fuime::Offer::MAX_SLUG_LENGTH,
                                               placeholder: "lawn-mow", class: "text-sm" %>
                    <%= form.submit "Save link", class: "btn btn--sm" %>
                  <% end %>
                  <p class="muted text-sm mt-1 mb-0">
                    Lowercase letters, numbers and hyphens. Links you've already
                    shared keep working.
                  </p>
                </details>
              <% end %>
            <% end %>
          </td>
          <% if @can_manage %>
            <td>
              <div class="flex gap-1 flex-wrap">
                <% if offer.draft? %>
                  <%# Same rule as the wizard's review step: while the venture has
                      publish blockers this button can only fail, and the callout
                      at the top of the page already explains why. A disabled
                      control that states its own reason beats a live one that
                      bounces — and beats hiding it, since a founder coming back
                      after the review needs to see where Publish will appear. %>
                  <% if @selling_blockers.any? %>
                    <button type="button" class="btn bg-muted" disabled
                            title="<%= @selling_blockers.first %>">
                      Publish
                    </button>
                  <% else %>
                    <%= button_to "Publish", fuime_offer_publish_path(event_slug: @event.slug, id: offer.id),
                                  method: :post, class: "btn" %>
                  <% end %>
                <% else %>
                  <%= button_to "Take down", fuime_offer_unpublish_path(event_slug: @event.slug, id: offer.id),
                                method: :post, class: "btn bg-muted" %>
                  <%= link_to "Share", fuime_offer_share_path(event_slug: @event.slug, id: offer.id),
                              class: "btn bg-muted" %>
                <% end %>
                <%= button_to "Archive", fuime_offer_archive_path(event_slug: @event.slug, id: offer.id),
                              method: :post, class: "btn bg-muted",
                              form: { data: { turbo_confirm: "Archive \"#{offer.name}\"? Payments people already made for it aren't affected." } } %>
              </div>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @archived.any? %>
  <details class="mt2">
    <summary class="muted">Archived (<%= @archived.count %>)</summary>
    <table class="min-w-0 mt1">
      <tbody>
        <% @archived.each do |offer| %>
          <tr>
            <td><%= offer.name %></td>
            <td class="muted"><%= offer.price_sentence %></td>
            <% if @can_manage %>
              <td>
                <%= button_to "Restore as draft", fuime_offer_restore_path(event_slug: @event.slug, id: offer.id),
                              method: :post, class: "btn bg-muted" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </details>
<% end %>

<%# Terms stay on the listing so a founder publishing from the table still
    sees them — not as a wall in front of drafting. %>
<%= render "fuime/operator_sale_terms", event: @event, confirmable: @can_manage %>

<% unless @can_manage %>
  <p class="muted mt2">
    You can see everything this business sells. Only the person running it can
    change what's listed or what it costs.
  </p>
<% end %>
