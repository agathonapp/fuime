<% title "Your price — #{@event.name}" %>
<% content_for :progress, wizard_progress %>
<% content_for :wizard_title, "Your price" %>

<% content_for :info_pane do %>
  <h2 class="text-4xl mt-0">You set the price</h2>
  <p class="mt-0 text-lg muted">
    Fuime never sets it or suggests one. Type the amount you charge.
  </p>
<% end %>

<%= render "fuime/offers/wizard/steps", current: "price" %>

<%= form_with url: fuime_offer_wizard_path(event_slug: @event.slug, step: "price"),
              method: :post, scope: :fuime_offer, local: true,
              id: "offer_wizard" do |form| %>
  <div class="flex gap-2 flex-wrap">
    <div class="field flex-1">
      <%= form.label :price, "Your price" %>
      <%# No placeholder amount. A number here would be a Fuime-suggested
          rate for every operator who left it alone. %>
      <%= form.text_field :price, required: true, inputmode: "decimal",
                          placeholder: "$", class: "w-full",
                          value: @offer.price_cents.present? ? format("%.2f", @offer.price_cents / 100.0) : nil %>
    </div>
    <div class="field flex-1">
      <%= form.label :unit_label, "Per what? (optional)" %>
      <%# "per lawn" was hard-coded, so a dog walker, a tutor and an illustrator
          were all shown a lawn-care example. Unlike the price box — where a
          number would read as a Fuime-suggested rate — a unit is a grammar hint
          and costs nothing to make fit the business. %>
      <%= form.text_field :unit_label, class: "w-full", maxlength: Fuime::Offer::MAX_UNIT_LABEL_LENGTH, value: @offer.unit_label, placeholder: unit_label_placeholder_for(@event) %>
    </div>
  </div>

  <%# What Fuime keeps, said on the screen where the number is chosen.
      It was only stated two steps later, in the sale terms on the review page,
      after the price was set. A founder deciding what to charge is entitled to
      know the take-rate at the moment they decide — and being told it here,
      before they commit, is the difference between a fee and a surprise.
      Read from the venture's own plan, never from the 5% fallback constant. %>
  <p class="muted text-sm mt-2 mb-0">
    Fuime keeps <%= number_to_percentage(@event.revenue_fee * 100, precision: 0) %> of each sale,
    plus what the card network charges. You'll see both on every sale in your ledger.
  </p>
<% end %>

<% content_for :footer do %>
  <div class="flex flex-row-reverse justify-between items-center w-full">
    <button type="submit" class="btn bg-blue" form="offer_wizard">Continue →</button>
    <%= link_to "← Back", new_fuime_offer_step_path(event_slug: @event.slug, step: "what"), class: "btn bg-muted" %>
  </div>
<% end %>
