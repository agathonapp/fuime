<% title "Family plan" %>
<%= render "users/nav", selected: :settings_billing %>

<h1 class="heading"><span class="flex-grow">Family plan</span></h1>

<% if params[:subscribed].present? %>
  <%= render "application/callout", type: "success", title: "Welcome to the family plan" do %>
    <p class="mb-0">Once Stripe confirms the payment (usually seconds), every venture in your family drops to
      <%= number_to_percentage(Event::Plan::Pro::REVENUE_FEE * 100, precision: 1) %>.</p>
  <% end %>
<% end %>

<div class="card mt2">
  <% if @subscription&.active? %>
    <h3 class="mt0">You're on the family plan 🎉</h3>
    <p>
      Every venture your family runs, at
      <strong><%= number_to_percentage(Event::Plan::Pro::REVENUE_FEE * 100, precision: 1) %></strong> —
      unlimited businesses, one subscription.
      <% if @subscription.current_period_end %>
        Renews <%= @subscription.current_period_end.strftime("%B %-d, %Y") %><%= @subscription.cancel_at_period_end ? " (set to cancel)" : "" %>.
      <% end %>
    </p>
    <%# Fuime: a comped plan has no Stripe customer behind it, so the portal would
        have nothing to open. Say who gave it to them instead of showing a button
        that answers "nothing to manage yet". %>
    <% if @subscription.comped? %>
      <p class="muted mb-0">Fuime comped this plan for your family, so there's nothing to pay and no card on file.</p>
    <% elsif @is_adult %>
      <%# Fuime: turbo: false is load-bearing — see the Upgrade button below. %>
      <%= button_to "Manage billing", my_billing_portal_path, class: "btn btn--secondary", form: { data: { turbo: false } } %>
      <p class="muted text-sm mt-1">Card changes, invoices, and cancellation happen in Stripe's secure portal — Fuime never sees your card.</p>
    <% end %>
  <% else %>
    <h3 class="mt0">Free plan</h3>
    <p>
      One venture, with Fuime keeping
      <strong><%= number_to_percentage(Event::Plan::Free::REVENUE_FEE * 100, precision: 1) %></strong> of what it collects.
      The family plan is
      <%# Fuime: render_money, not integer division. `1999 / 100` is 19 in Ruby,
          so this page advertised "$19/month" and Stripe charged $19.99 — a
          price the product does not have, on the one screen whose entire job is
          stating the price. %>
      <strong><%= render_money(@pro_plan.monthly_fee_cents) %>/month</strong> for
      <strong>unlimited businesses</strong> at
      <strong><%= number_to_percentage(Event::Plan::Pro::REVENUE_FEE * 100, precision: 1) %></strong>.
    </p>
    <% if @is_adult %>
      <%# Fuime: `turbo: false`, and it is the whole reason this button worked.
          #subscribe answers with a 302 to checkout.stripe.com. Turbo Drive
          submits button_to over fetch, and a fetch cannot render a cross-origin
          redirect — so the session was created on Stripe every single click and
          the browser simply sat there. Three live sessions were opened in 90
          seconds by somebody pressing a button that looked dead.
          Opting out makes it an ordinary form post, which the browser follows
          across origins by itself. Same reason payout_methods/show does it for
          Plaid. %>
      <%= button_to "Upgrade — #{render_money(@pro_plan.monthly_fee_cents)}/mo", my_billing_subscribe_path, class: "btn bg-accent", form: { data: { turbo: false } } %>
      <p class="muted text-sm mt-1">Payment happens in Stripe's secure checkout — Fuime never sees your card.</p>
      <%# Staff reach the buttons without a birthday on file (User#staff?), so
          say whose card this is: the subscription belongs to the signed-in
          account, not to whoever the admin was just looking at. %>
      <% if @is_staff && !current_user.known_adult? %>
        <p class="muted text-sm mb-0">You're seeing the adult view as Fuime staff. This subscribes <strong><%= current_user.email %></strong>.</p>
      <% end %>
    <% elsif @guardians.any? %>
      <p class="mb-0">
        The family plan is billed to a parent or guardian — ask
        <strong><%= @guardians.map { |g| g.name.presence || g.email }.to_sentence %></strong>
        to upgrade from their account.
      </p>
    <% else %>
      <p class="mb-0">The family plan is billed to a parent or guardian, so it unlocks once yours has joined Fuime.</p>
    <% end %>
  <% end %>
</div>

<p class="muted text-sm mt-3 mb-0">
  Fuime is a financial technology company, not a bank. The subscription covers Fuime's software;
  payment processing on venture sales is provided by Stripe and itemised separately.
</p>
