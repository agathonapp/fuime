<% title "Guardian Invitation" %>
<% page_full %>

<main class="center max-w-xl card mt4 md-p3 mx-auto">
  <h1 class="mt0 border-0 mb-2">You've been invited!</h1>

  <p class="text-lg mb-3">
    <strong><%= @guardianship.minor.name || @guardianship.minor.email %></strong> has invited you to be their guardian on Fuime.
  </p>

  <div class="bg-smoke rounded-lg p-4 mb-4">
    <h3 class="mt-0 mb-2">What this means:</h3>
    <ul class="list-disc pl-5 mb-0">
      <li class="mb-1">You'll be the legal signer for their teen business account</li>
      <li class="mb-1">You can view all their transactions and business activity</li>
      <li class="mb-1">You'll receive important notifications about their account</li>
      <li class="mb-1">At tax time, you'll get a summary to share with your accountant</li>
    </ul>
  </div>

  <%= render "application/callout", type: "warning" do %>
    <strong>Responsibility Notice:</strong> By accepting, you agree to serve as the responsible adult
    for this minor's business activities on Fuime. You should only accept if you are
    this person's parent or legal guardian.
  <% end %>

  <div class="flex justify-center items-center flex-wrap mt-4 gap-3">
    <%= link_to "Accept & Sign", accept_guardianship_path(@guardianship.invite_token),
                method: :post,
                class: "btn bg-success text-lg px-6 py-3",
                data: { confirm: "I confirm that I am the parent or legal guardian of #{@guardianship.minor.name || 'this minor'} and accept responsibility for their Fuime account." } %>
  </div>

  <p class="text-sm muted mt-4 text-center">
    Questions? Contact us at support@fuime.com
  </p>
</main>
