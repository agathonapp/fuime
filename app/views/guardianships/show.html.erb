<% title "Guardian Invitation" %>
<% page_full %>

<% if @wrong_account %>
<%# Fuime: the link was opened while signed in as somebody other than the invited
    guardian (GuardianshipsController#show). Before this was a flash and a bounce to
    the dashboard with no way out (ONBOARDING_PLAN §2 #10). The redacted address is
    all this page reveals about the invite — no teen's name, no venture. %>
<main class="center max-w-xl card mt4 md-p3 mx-auto">
  <h1 class="mt0 border-0 mb-2">This invitation is for a different account</h1>

  <p class="text-lg mb-3">
    This invitation was sent to <strong><%= @invited_email %></strong>, but you're
    signed in as <strong><%= current_user.email %></strong>.
  </p>

  <p class="mb-4">
    Sign out, then open the link from the email again and sign in with the address
    it was sent to.
  </p>

  <%# Plain form post to the same route the user menu uses (users#logout). %>
  <%= button_to "Sign out and open the link again", logout_users_path,
                method: :delete,
                class: "btn bg-accent",
                form: { data: { turbo: false } } %>

  <p class="text-sm muted mt-4 text-center">
    Questions? Contact us at <%= mail_to "support@fuime.com" %>
  </p>
</main>
<% else %>
<%# Fuime: the accept page. Its body is left at the indentation it had before
    the wrong-account branch above was added, so the checkbox label and the
    agreement rendering below are byte-for-byte what past signers saw. %>
<% merchant_of_record = ::Fuime::Features.merchant_of_record? %>
<% teen_name = @guardianship.minor.name || @guardianship.minor.email %>
<main class="center max-w-2xl card mt4 md-p3 mx-auto">
  <h1 class="mt0 border-0 mb-2">
    <%= teen_name %> needs a parent to sign off<%= " on #{@venture_name}" if @venture_name.present? %>
  </h1>

  <p class="text-lg mb-3">
    <strong><%= teen_name %></strong> named you as their parent or guardian on
    Fuime, a financial platform for young founders. Here's what you're agreeing to.
  </p>

  <div class="bg-smoke rounded-lg p-4 mb-4">
    <ul class="list-disc pl-5 mb-0">
      <%# Ownership direction matters and is easy to invert. The guardian is the legal
          signer and responsible adult; the minor operates the venture. Copy that reads
          "their account, with you on it" misdescribes who holds the obligations.

          Only promises the product keeps (L8): the earlier "important notifications"
          and "tax time summary" bullets described mailers that do not exist. The third
          bullet names what the signature actually gates — payouts under
          merchant-of-record (Event#payout_setup_blockers), activation under Connect
          (Event::Application#activation_blockers).

          Under MoR it must NOT say "you approve every payout": payouts run as a weekly
          Fuime::PayoutBatch a Fuime admin approves, and a scheduled batch line has no
          teen request for the guardian to decide (EventPolicy#decide_payout? covers
          only the PayoutRequests a teen files). What the guardian does control is
          the destination — EventPolicy#setup_payments? and #connect_payout_method?
          are guardian-only on a family venture — and whether a payout can happen at
          all, since Event#payout_setup_blockers refuses while any operator has no
          guardian or no usable destination exists. %>
      <li class="mb-1">You'll be the legal signer and responsible adult for <%= @venture_name.presence || "their business" %>. <%= teen_name %> runs it day to day.</li>
      <li class="mb-1">You can see every transaction, always. <%= teen_name %> can't turn that off.</li>
      <% if merchant_of_record %>
        <li class="mb-1">Nothing is paid out until you've accepted and set up where the money goes. Money only ever goes to a destination a parent or guardian set up.</li>
      <% else %>
        <li class="mb-1">Nothing goes live until you accept.</li>
      <% end %>
    </ul>
  </div>

  <%# Structural preconditions only (known-under-18 guardian, self-invite).
      The common invited parent is a stub / 13+ attested user: the 18+ claim
      lives on the checkbox below. Hiding the form when that "blocker" is
      present left parents with a message that said "tick the box below" and
      no box — and an "Update my details" link to a settings page that cannot
      make them an adult. %>
  <% structural_blockers = @guardianship.structural_activation_blockers %>
  <% if structural_blockers.any? %>
    <%= render "application/callout", type: "warning", title: "Before you can sign" do %>
      <ul class="list-disc pl-5 mb-2">
        <% structural_blockers.each do |blocker| %>
          <li><%= blocker %></li>
        <% end %>
      </ul>
      <%= link_to "Update my details",
                  edit_user_path(current_user, return_to: guardianship_path(@guardianship.invite_token)),
                  class: "btn bg-accent" %>
    <% end %>
  <% end %>

  <h2 class="mb-2 mt-4">Guardian agreement</h2>
  <div class="border rounded-lg p-4 mb-4 overflow-y-auto" style="max-height: 24rem">
    <% if (partial = @guardianship.agreement_partial) %>
      <%= render partial, minor: @guardianship.minor, guardian: @guardianship.guardian %>
    <% else %>
      <p class="error mb-0">
        The agreement text could not be loaded. Please contact
        <%= mail_to "support@fuime.com" %> before signing.
      </p>
    <% end %>
  </div>

  <% if @guardianship.can_present_accept_form? %>
    <%= form_with url: accept_guardianship_path(@guardianship.invite_token),
                  method: :post,
                  data: { turbo: false },
                  html: { id: "guardian-accept-form" } do |f| %>
      <div class="field field--checkbox mb-3" style="align-items: flex-start;">
        <%= check_box_tag :agree, "1", false,
                          required: true,
                          id: "agree",
                          class: "mt1",
                          style: "width: 1.25rem; height: 1.25rem; flex-shrink: 0;",
                          aria: { required: true } %>
        <%= label_tag :agree do %>
          I confirm I am the parent or legal guardian of
          <strong><%= @guardianship.minor.name || "this minor" %></strong>,
          that I am 18 or older, and I agree to the guardian agreement above.
        <% end %>
      </div>

      <div class="flex justify-center items-center flex-wrap gap-3">
        <%# "I agree", not "Agree & activate their account": under merchant-of-record
            accepting unblocks payouts, not activation, so the old label promised
            the wrong thing on the one button a parent presses. %>
        <%= f.submit "I agree",
                     class: "btn bg-success text-lg px-6 py-3",
                     id: "guardian-accept-submit" %>
      </div>
    <% end %>

    <p class="text-sm muted mt-3 text-center">
      We'll record the date, your IP address, and the version of the agreement
      you signed. This is not an identity check. You can withdraw your consent
      at any time.
    </p>
  <% end %>

  <p class="text-sm muted mt-4 text-center">
    Questions? Contact us at <%= mail_to "support@fuime.com" %>
  </p>
</main>
<% end %>
