<% turbo_page_requires_reload if params[:require_reload].present? %>
<% title_text = @login.for_application? ? "Verify your email" : @signup ? "Start your business on Fuime" : "Sign in to Fuime" %>
<% title title_text %>
<%# The sign-up sub-line has to be true for the money model that is actually
    running. Under merchant-of-record a teen can set up before a guardian has
    done anything — the guardian gates payouts — but not sell: a human at Fuime
    approves every venture first (Fuime::OperatorEligibility, "This venture has
    not been approved by Fuime yet."), so "start selling now" was a promise the
    product does not keep. Under Connect the guardian owns the account, so
    nothing is live until they have signed (docs/fuime/ONBOARDING_PLAN.md §3,
    "sell first, paperwork when there is money"). Never promise the MoR sentence
    when MoR is off. %>
<% mor_subline = "Free to start. About two minutes. Under 18? You can set up now and sell as soon as Fuime approves your business — a parent or guardian signs off before you get paid." %>
<% connect_subline = "Free to start. About two minutes. Under 18? You can set up now — a parent or guardian signs off before your venture goes live." %>
<% signup_subline = ::Fuime::Features.merchant_of_record? ? mor_subline : connect_subline %>

<% content_for :info_pane do %>
  <%= render partial: "logins/apply_info_pane" %>
<% end %>

<div class="flex flex-col flex-1 justify-center w-full <%= @login.for_application? ? "card" : "max-w-md" %>">
  <div class="my-auto">
    <%= render "logins/header", header_label: @login.for_application? ? "Apply for Fuime" : "Fuime" do %>
      <%= title_text %>
    <% end %>

    <% if @signup && !@login.for_application? %>
      <p class="mt-2 mb-0 muted"><%= signup_subline %></p>
    <% end %>

    <%= form_for @login, class: "mt-1", id: "login", 'data-action': "webauthn-auth#submit", 'data-webauthn-auth-target': "authForm" do |form| %>
      <div data-webauthn-auth-target="error" class="mb2 display-none">
        <p class="flash error mb1 mx-auto">Security key authentication failed.</p>
      </div>

      <%= form.hidden_field :return_to %>
      <%= form.hidden_field :purpose %>
      <%= form.hidden_field :referral_link_id %>

      <%= email_field_tag :email, @prefill_email, placeholder: "Enter your email...", autofocus: true, autocomplete: "username", class: "!max-w-full w-full", style: "padding: 12px 15px", required: true, "data-webauthn-auth-target" => "loginEmailInput" %>
      <%= invisible_captcha :remember_me %>

      <div class="flex justify-between items-center gap-4">
        <% if @login.for_application? %>
          <span></span>
        <% else %>
          <% if @signup %>
            <%= link_to "Sign in", auth_users_path(return_to: @login.return_to), class: "mt-3" %>
          <% else %>
            <%= link_to "Sign up", auth_users_path(signup: true, return_to: @login.return_to), class: "mt-3" %>
          <% end %>
        <% end %>

        <button data-webauthn-auth-target="continueButton" type="submit" class="mt-4 gap-2 btn">
          Continue
        </button>
      </div>

      <%= link_to "Sign in another way", choose_login_preference_logins_path(return_to: @login.return_to), class: "display-none block mt2 no-underline", data: { "webauthn-auth-target" => "loginCode" } %>
    <% end %>
  </div>

  <%= render partial: "logins/environment_banner" %>
</div>

<% unless @login.for_application? %>
  <%= render partial: "logins/footer", locals: { whats_hcb: true } %>
<% end %>

<% content_for :footer do %>
  <%= link_to "← Back", new_application_path, class: "btn bg-muted" %>
  <button data-webauthn-auth-target="continueButton" type="submit" class="btn" form="login">
    Continue →
  </button>
<% end %>
