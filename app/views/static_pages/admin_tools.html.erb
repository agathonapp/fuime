<%= turbo_frame_tag(:admin_tools, target: "_top", class: "w-full") do %>
  <% admin_tool("w-100 mt-10 text-left") do %>
    <%# Fuime: this panel used to render every admin destination at once — five
        headings, ~30 equally-weighted cards, and an Alpine "pin a card" feature
        that existed only because the wall was too big to scan.

        The queues are now split from the reference links: anything with work
        outstanding surfaces at the top, everything else is one keystroke away
        behind a disclosure. The pin feature went with the wall it was working
        around. No destination was removed — the two lists live in
        StaticPagesHelper#admin_queues and #admin_directories. %>

    <% queues = admin_queues %>
    <% needs_you = queues.select { |tool| tool[:badge].to_i.positive? } %>

    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4 pb-2 border-b border-solid" style="border-color: rgba(150, 150, 150, 0.25)">
      <h2 class="m-0 p-0 border-none">Admin</h2>
      <p class="m-0 muted text-sm">
        <strong class="tabular-nums"><%= render_money(@transaction_volume) %></strong> moved through Fuime
      </p>
    </div>

    <% if needs_you.any? %>
      <h3 class="mt-0 mb-2 text-base muted caps">Needs you</h3>
      <ul class="grid grid--medium-narrow text-left w-100 mt0 mb-6">
        <% needs_you.each do |tool| %>
          <%= card_to tool[:name], tool[:path], badge: tool[:badge] %>
        <% end %>
      </ul>
    <% else %>
      <p class="muted mt-0 mb-6 flex items-center gap-2">
        <%= inline_icon "check-circle", size: 18, class: "text-success" %>
        Every queue is clear.
      </p>
    <% end %>

    <details class="w-full">
      <summary class="cursor-pointer muted">All admin tools</summary>
      <div class="mt-3">
        <% quiet_queues = queues - needs_you %>
        <% if quiet_queues.any? %>
          <h3 class="mt-0 mb-2 text-base muted caps">Queues</h3>
          <ul class="grid grid--medium-narrow text-left w-100 mt0 mb-5">
            <% quiet_queues.each do |tool| %>
              <%= card_to tool[:name], tool[:path], badge: tool[:badge], subtle_badge: true %>
            <% end %>
          </ul>
        <% end %>

        <% admin_directories.each do |heading, tools| %>
          <h3 class="mt-0 mb-2 text-base muted caps"><%= heading %></h3>
          <ul class="grid grid--medium-narrow text-left w-100 mt0 mb-5">
            <% tools.each do |tool| %>
              <%= card_to tool[:name], tool[:path], badge: tool[:badge], subtle_badge: tool[:subtle] %>
            <% end %>
          </ul>
        <% end %>
      </div>
    </details>
  <% end %>
<% end %>
