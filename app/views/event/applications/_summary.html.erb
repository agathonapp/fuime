<%# locals: (application:, allow_edits: false) %>

<% blank = capture do %>
<em>Blank</em>
<% end %>

<% missing = capture do %>
<em class="text-primary">Missing</em>
<% end %>

<div>
  <div class="flex items-center justify-between gap-4 mb-4">
    <h3 class="text-2xl my-0">Business Information</h3>
    <% admin_tool_if(!allow_edits) do %>
      <%= link_to allow_edits ? project_info_application_path(application) : edit_application_path(application), class: "btn text-sm flex items-center gap-1" do %>
        <%= inline_icon "edit", size: 16 %>
        Edit
      <% end %>
    <% end %>
  </div>
  <div class="card card--breakdown p-4 space-y-4">
    <%# Fuime: the business-type answer, which this summary did not show at all.
        It is the FIRST thing the flow asks and the source of `business_category`
        — the field Fuime::OperatorEligibility reads to decide whether the venture
        may sell anything — so it was the one answer a founder could neither check
        nor correct on the page whose entire job is checking answers. Its own
        Edit link, because it is a step of its own (business_type), not part of
        the description step below. %>
    <div>
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-sm muted mb-1 mt-0">What kind of business</p>
          <p class="mb-0 font-medium">
            <% if application.service.present? %>
              <%= application.service.name %>
            <% else %>
              <%= missing %>
            <% end %>
          </p>
          <% if (point = Fuime::ServiceCatalog.starting_point(application.starting_point)) %>
            <p class="text-sm muted mb-0 mt-1"><%= point.name %></p>
          <% end %>
        </div>
        <% if allow_edits %>
          <%= link_to "Edit", business_type_application_path(application), class: "btn text-sm flex-shrink-0" %>
        <% end %>
      </div>
    </div>
    <div>
      <p class="text-sm muted mb-1 mt-0">Business name</p>
      <p class="mb-0 font-medium"><%= application.name.present? ? application.name : missing %></p>
    </div>
    <div>
      <p class="text-sm muted mb-1">What the business does</p>
      <p class="mb-0 whitespace-pre-wrap"><%= application.description.present? ? application.description : missing %></p>
    </div>
    <div>
      <p class="text-sm muted mb-1">Website</p>
      <p class="mb-0"><%= application.website_url.present? ? "Yes" : "No" %></p>
      <% if application.website_url.present? %>
        <p class="mb-0 whitespace-pre-wrap"><%= application.website_url %></p>
      <% end %>
    </div>
    <div>
      <p class="text-sm muted mb-1">Political activity involvement</p>
      <p class="mb-0"><%= application.political_description.present? ? "Yes" : "No" %></p>
      <% if application.political_description.present? %>
        <p class="mb-0 whitespace-pre-wrap"><%= application.political_description %></p>
      <% end %>
    </div>
    <div>
      <p class="text-sm muted mb-1">Previously applied to Fuime</p>
      <p class="mb-0">
        <% if application.previously_applied == true %>
          Yes
        <% elsif application.previously_applied == false %>
          No
        <% else %>
          <%= missing %>
        <% end %>
      </p>
    </div>
    <% unless application.teen_led? %>
      <div>
        <p class="text-sm muted mb-1">Planning duration</p>
        <p class="mb-0 whitespace-pre-wrap"><%= application.planning_duration.present? ? application.planning_duration : missing %></p>
      </div>
      <div>
        <p class="text-sm muted mb-1">Team size</p>
        <p class="mb-0 whitespace-pre-wrap"><%= application.team_size.present? ? application.team_size : missing %></p>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <p class="text-sm muted mb-1 mt-0">Annual budget</p>
          <p class="mb-0 whitespace-pre-wrap"><%= application.annual_budget.present? ? application.annual_budget.format : missing %></p>
        </div>
        <div>
          <p class="text-sm muted mb-1 mt-0">Committed amount</p>
          <p class="mb-0 whitespace-pre-wrap"><%= application.committed_amount.present? ? application.committed_amount.format : missing %></p>
        </div>
      </div>
      <% if application.committed_amount&.positive? %>
        <div>
          <p class="text-sm muted mb-1">Funding source</p>
          <p class="mb-0 whitespace-pre-wrap"><%= application.funding_source.present? ? application.funding_source : missing %></p>
        </div>
      <% end %>
    <% end %>
    <div>
      <p class="text-sm muted mb-1">Affiliations</p>
      <% if application.affiliations.any? %>
        <ul class="list-disc list-inside my-0 pl-5">
          <% application.affiliations.each do |affiliation| %>
            <li><%= affiliation %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mb-0">
          No affiliations added
        </p>
      <% end %>
    </div>
  </div>
</div>

<div>
  <div class="flex items-center justify-between gap-4 mb-4">
    <h3 class="text-2xl my-0">Personal Information</h3>
    <% admin_tool_if(!allow_edits) do %>
      <%= link_to allow_edits ? personal_info_application_path(application) : edit_application_path(application), class: "btn text-sm flex items-center gap-1" do %>
        <%= inline_icon "edit", size: 16 %>
        Edit
      <% end %>
    <% end %>
  </div>
  <div class="card card--breakdown p-4 space-y-4 mb-6">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-sm muted mb-1 mt-0">Full name</p>
        <p class="mb-0"><%= application.user.full_name.present? ? application.user.full_name : missing %></p>
      </div>
      <div>
        <p class="text-sm muted mb-1 mt-0">Email</p>
        <p class="mb-0"><%= application.user.email.present? ? application.user.email : missing %></p>
      </div>
      <%# Fuime: the age ANSWER, not a birthday.
          This row read `user.birthday` and printed a red "Missing" whenever it
          was absent — which, since AddAgeAttestationToUsers, is every founder
          who came through the current flow, because the form stopped asking. The
          attestation is the answer now; a stored date still satisfies it for
          people who applied before the switch. Same either-source test as
          Event::Application#submission_blockers, which is what decides whether
          this is actually outstanding. %>
      <div>
        <p class="text-sm muted mb-1">Age</p>
        <p class="mb-0">
          <% if application.user.known_adult? %>
            Confirmed 18 or older
          <% elsif application.user.age_attestation.present? %>
            Confirmed 13 or older
          <% elsif application.user.birthday.present? %>
            <%= application.user.birthday.strftime("%B %-d, %Y") %>
          <% else %>
            <%= missing %>
          <% end %>
        </p>
      </div>
      <%# Only when there is one. The application stopped asking for a phone
          number, so an empty row here is not something the founder can act on —
          it is a field that no longer exists, rendered as a fault. Historic
          applications that carry one still show it. %>
      <% if application.user.phone_number.present? %>
        <div>
          <p class="text-sm muted mb-1">Phone number</p>
          <p class="mb-0"><%= application.user.phone_number %></p>
        </div>
      <% end %>
      <div>
        <p class="text-sm muted mb-1">Country</p>
        <p class="mb-0"><%= application.address_country.present? ? application.address_country : missing %></p>
      </div>
    </div>

    <%# Fuime: the payout address, shown only once one exists.
        Street, city, state and zip moved to the payout seam
        (personal_info.html.erb) and are no longer part of submitting. Rendered
        unconditionally they put five red "Missing" labels on the last screen
        before Submit, next to a Submit button that was enabled and correct —
        telling every founder their finished application was broken. They stay
        visible for applications that DO carry an address: pre-change
        submissions, and anyone who has since supplied one for a payout. %>
    <% if application.address_line1.present? || application.address_city.present? ||
          application.address_state.present? || application.address_postal_code.present? %>
      <% address_lines = [
           application.address_line1,
           application.address_line2,
           [application.address_city, application.address_state].compact_blank.join(", ").presence,
           application.address_postal_code
         ].compact_blank %>
      <div>
        <p class="text-sm muted mb-1">Payout address</p>
        <p class="mb-0"><%= safe_join(address_lines, tag.br) %></p>
      </div>
    <% end %>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <p class="text-sm muted mb-1">How did you hear about Fuime?</p>
        <p class="mb-0"><%= application.referrer.present? ? application.referrer : missing %></p>
      </div>
      <% admin_tool do %>
        <div>
          <p class="text-sm muted mb-1">Referral code</p>
          <p class="mb-0"><%= application.referral_code.present? ? application.referral_code : blank %></p>
        </div>
      <% end %>
    </div>

    <% if application.accessibility_notes.present? %>
      <div>
        <p class="text-sm muted mb-1">Accessibility needs</p>
        <p class="mb-0 whitespace-pre-wrap"><%= application.accessibility_notes %></p>
      </div>
    <% end %>

    <%# Fuime: `minor_or_unknown_age?`, the fail-closed twin of `is_minor?`.
        `is_minor?` is nil without a date of birth, and the form stopped asking
        for one — so this block hid the parent's email from exactly the founders
        it exists for. Worse, cosigner_email IS required to submit for the same
        population (Event::Application#required_submission_fields uses this same
        predicate), so the review page listed "Parent or guardian email" as a
        blocker while refusing to show the field it was talking about. %>
    <% if application.user.minor_or_unknown_age? %>
      <div>
        <p class="text-sm muted mb-1">Parent email</p>
        <p class="mb-0">
          <% if application.cosigner_email.present? && application.cosigner_email == application.user.email %>
            <span class="text-primary"><%= application.cosigner_email %></span> - <em>you cannot use your own email</em>
          <% else %>
            <%= application.cosigner_email.present? ? application.cosigner_email : missing %>
          <% end %>
        </p>
      </div>

      <% admin_tool "p-2" do %>
        <p class="mt-0 mb-2"><strong>Parent email updates</strong></p>
        <ul class="list-reset m-0">
          <% field = "cosigner_email" %>
          <% application.versions.reverse.select { |version| version.changeset[field]&.any?(&:present?) }.map do |version| %>
            <% change = version.changeset[field] %>
            <li>
              <%= format_date version.created_at %>:
              <%= render_audit_log_value(field, change[0], color: "primary") %> → <%= render_audit_log_value(field, change[1], color: "success") %>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
</div>
