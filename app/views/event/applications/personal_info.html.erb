<% title "Add your information" %>
<% content_for :progress, 50 %>

<% content_for :info_pane do %>
  <div class="flex flex-col">
    <h2 class="text-4xl">
      Add your information
    </h2>

    <p class="mt-0 text-lg muted">Tell us a bit about yourself</p>

    <div id="user_errors"></div>
  </div>
<% end %>

<%= form_with model: @application, url: application_path(@application), method: :patch, id: "edit_application_#{@application.id}", class: "mt-7", data: { action: "input->application-autosave#save", "application-autosave-target": "form" } do |form| %>
<%# Fuime: `minor` is no longer derived from a birthday the form stops asking for.
    It reads #minor_or_unknown_age?, which is the SAME fail-closed test
    Event::Application#required_submission_fields uses to decide whether
    cosigner_email is required — so the field the founder sees and the field the
    model demands can no longer disagree. A checkbox-only applicant is treated as
    a minor, which is the correct default for a platform whose users are teens. %>
  <div class="card mb-6" x-data="{ minor: <%= @application.user.minor_or_unknown_age? || false %>, country: '<%= @application.address_country.presence %>', disallowed_countries: '<%= Event::Application::DISALLOWED_COUNTRIES.join(",") %>'.split(',') }">
    <div class="md:flex items-end gap-2">
      <div class="field flex-1">
        <%= form.label :full_name do %>
          Full name <span class="text-primary">*</span>
        <% end %>
        <%= form.text_field :full_name, value: @application.user.full_name.presence, required: true, placeholder: "Fiona Hackworth III", style: "max-width:100%", pattern: '^\S+.+' %>
      </div>
      <div class="field flex-1">
        <%= form.label :preferred_name, "Preferred name (optional)" %>
        <%= form.text_field :preferred_name, value: @application.user.preferred_name.presence, style: "max-width:100%", placeholder: "FiFi Hacks", maxlength: 30 %>
      </div>
    </div>

    <%# Fuime: the mobile phone field is gone.
        Nothing in the application, the contract or Connect onboarding reads it —
        it was an HCB inheritance, and it is one more required field between a
        teenager and finding out whether anyone will buy their thing. Stripe
        collects a phone number itself where KYC actually needs one.

        The birthday date-select is gone too, replaced by the confirmation the
        controller has accepted since AddAgeAttestationToUsers. The view was the
        stale half of that change: #update already routes the answer through
        #attest_minor_13_plus! and `:birthday` is already dropped from
        `user_params`, so this select had been submitting a field nothing read.

        Deliberately NOT a date of birth: an exact age is only needed where a
        floor above 13 applies, and Fuime::OperatorEligibility says so in the one
        sentence it shows the founder if that ever becomes true again. %>
    <% unless @application.user.age_attestation.present? || @application.user.birthday.present? %>
      <div class="field">
        <div class="inline-flex items-center justify-between w-full gap-1">
          <%= form.label :age_attestation_confirmed, "Your age" %>
          <div class="info tooltipped tooltipped--w h-[18px]" aria-label="Fuime works with money, so we need to know whether you're a minor — that's what decides if a parent or guardian has to be on the account. We don't need your exact birthday for that.">
            <%= inline_icon "info", size: 18 %>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <%= check_box_tag "event_application[age_attestation_confirmed]", "1", false,
                            id: "event_application_age_attestation_confirmed", required: true %>
          <%= label_tag "event_application_age_attestation_confirmed", "I'm 13 or older" %>
        </div>
      </div>
    <% end %>

    <% if @application.user.applications.many? || @application.user.events.any? %>
      <div class="mt-[-0.25rem] mb-4 rounded-b-lg h-2 border-solid border-smoke dark:border-slate border-t-0 w-full relative">
        <div class="absolute max-w-full w-max bottom-0 left-1/2 bg-white dark:bg-darkless px-2 muted text-sm -translate-x-1/2 translate-y-1/2">Changes made here will also update your Fuime profile</div>
      </div>
    <% end %>

    <hr class="col-span-2 mt-2 invisible mb-4">

    <%# Fuime: street, city, state and zip moved to the payout flow.
        Country stays, and stays required, because it is not really an address
        question — it is the sanctions/unsupported-country gate. DISALLOWED_COUNTRIES
        is checked here, in #submission_blockers and again in
        #application_ready_to_submit?, and dropping the field would silently
        disable all three (`nil.in?(array)` is false, so every application would
        pass). One dropdown is the cheapest way to keep that control honest.

        The rest is asked at the payout seam instead, which is where it is first
        genuinely needed — a payee, a 1099, a Connect account — and which is the
        principle CreateFuimePayoutMethods already applies to the guardian:
        ask for the paperwork at the moment the paperwork matters, not before a
        business has earned anything. %>
    <div class="grid grid-cols-2 gap-3 mb-2">
      <div class="field mb-0">
        <%= form.label :address_country do %>
          Country <span class="text-primary">*</span>
        <% end %>
        <% validate = "$el.setCustomValidity(disallowed_countries.includes(country) ? 'Fuime is not supported in this country' : '')" %>
        <%= form.country_select :address_country, { priority_countries: ["US"], priority_countries_divider: "", include_blank: "Select a country", required: true }, { class: "!min-h-[36px]", "x-model": "country", "x-on:change": validate, "x-init": validate } %>
      </div>
    </div>

    <template x-if="disallowed_countries.includes(country)">
      <div class="border border-1 border-primary/50 bg-primary/10 flex flex-row justify-start gap-2 items-center rounded-[6px] py-1 px-2 mt-4">
        <%= inline_icon "important", size: 20, class: "primary" %>
        <p class="primary text-sm m-0 p-0">Fuime is not supported in <span x-text="(country, event_application_address_country.selectedOptions[0].label)">that country</span>. This is because of regulatory restrictions, incompatible financial systems, or a combination of the two.</p>
      </div>
    </template>

    <hr class="col-span-2 mt-5 invisible mb-4">

    <div class="field">
      <%= form.label :referrer do %>
        How did you hear about Fuime? <span class="text-primary">*</span>
      <% end %>
      <%= form.text_field :referrer, class: "w-full !max-w-full", required: true %>
    </div>

    <div class="field">
      <%= form.label :accessibility_notes, "Accessibility needs" %>
      <%= form.text_area :accessibility_notes, class: "w-full max-w-full" %>
    </div>

    <div class="field col-span-2" x-show="minor">
      <%= form.label :cosigner_email do %>
        Parent email <span class="text-primary">*</span>
      <% end %>
      <p class="h5 muted mt0 mb1">We&#39;ll need a parent or legal guardian to sign the Fuime agreement. They&#39;re giving you permission to run a business on Fuime, and they will be able to see your business activity.</p>
      <%= form.email_field :cosigner_email, class: "w-full !max-w-full", required: true, placeholder: "parent@example.com", "x-bind:required": "minor", "x-on:input": "$el.value == '#{@application.user.email}' ? $el.setCustomValidity('You cannot use your own email') : $el.setCustomValidity('')" %>
    </div>
  </div>

  <%# Fuime: intl-tel-input and phone_input.js dropped with the phone field —
      they existed only to format it. Also removes the last two third-party CDN
      script tags from this page. %>
<% end %>

<% content_for :footer do %>
  <div class="flex flex-row-reverse justify-between items-center w-full">
    <button class="btn bg-blue" formaction="<%= application_path(@application, return_to: review_application_path(@application)) %>" form="edit_application_<%= @application.id %>">Continue →</button>

    <div class="flex gap-4">
      <button class="btn bg-muted" formnovalidate formaction="<%= application_path(@application, return_to: project_info_application_path(@application)) %>" form="edit_application_<%= @application.id %>" tabindex="1">← Back</button>
      <%= mobile_button_to archive_application_path(@application), text: "Archive application", icon: "delete", class: "btn btn--destroy", data: { turbo_confirm: "Are you sure you want to archive this application and remove it from your dashboard?" } %>
    </div>
  </div>
<% end %>
