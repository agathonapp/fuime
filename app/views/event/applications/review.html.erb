<% title "Review your application" %>
<% content_for :progress, 75 %>

<% blockers = @application.submission_blockers %>

<% content_for :info_pane do %>
  <div class="flex flex-col">
    <h2 class="text-4xl">
      Review your application
    </h2>

    <% if blockers.any? %>
      <p class="mt-0 text-lg muted">Your application is not yet complete. Please finish these first:</p>
      <ul class="list-disc list-inside mt-2 mb-0 text-primary">
        <% blockers.each do |blocker| %>
          <li><%= blocker %></li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-0 text-lg muted">Make sure everything looks correct before submitting</p>
    <% end %>
  </div>
<% end %>

<div class="flex flex-col items-center flex-grow">
  <div class="md:max-w-[600px] w-full mt-7 space-y-8 pb-5">
    <%= render "application/ooo_callout", resource: "application", financial: false, business_days: @application.response_business_days %>
    <%= render "event/applications/summary", application: @application, allow_edits: true %>
  </div>
</div>

<%# FUIME: an event code, entered last.

    Deliberately on THIS page rather than carried from the URL that brought them
    in. A code arrives on a slide, a whiteboard or a wristband and gets typed by
    fifty people at once — and the URL route through sign-in loses the parameter,
    which would silently drop somebody into the ordinary queue with nothing on
    screen explaining why their friend got in and they did not.

    Optional and quiet: an applicant without one should not feel they are missing
    something. See Fuime::Cohort. %>
<div class="card mb2">
  <%= form_with model: @application, url: application_path(@application), method: :patch do |form| %>
    <div class="field">
      <%= form.label :cohort_code, "Got an event code? (optional)" %>
      <p class="muted text-sm mt-0">
        If you're at an event that gave you a code, enter it here and your
        business gets set up right away.
      </p>
      <%= form.text_field :cohort_code,
                          value: @application.fuime_cohort&.code,
                          placeholder: "FOUNDERS26",
                          maxlength: Fuime::Cohort::MAX_CODE_LENGTH,
                          autocapitalize: "characters", autocomplete: "off" %>
    </div>
    <%= form.submit "Save code", class: "btn bg-muted" %>
  <% end %>

  <% if @application.fuime_cohort.present? %>
    <p class="success mt1">✓ You're in <%= @application.fuime_cohort.name %>.</p>
  <% elsif flash[:cohort_code_unknown] %>
    <%# Says the code did not work, and deliberately not whether it ever existed,
        was archived, expired or is full — an applicant cannot act on the
        difference, and the roster board tells the organiser who is stuck. %>
    <p class="error mt1">
      We didn't recognise that code. Check it with whoever gave it to you — you
      can still submit without one.
    </p>
  <% end %>
</div>

<% content_for :footer do %>
  <div class="flex flex-row gap-4 items-start justify-center">
    <%= link_to "← Back", personal_info_application_path(@application), class: "btn bg-muted" %>
    <%= mobile_button_to archive_application_path(@application), text: "Archive application", icon: "delete", class: "btn btn--destroy", data: { turbo_confirm: "Are you sure you want to archive this application and remove it from your dashboard?" } %>
  </div>
  <%= form_with model: @application, url: application_path(@application), method: :patch, id: "edit_application_#{@application.id}" do |form| %>
    <%= form.hidden_field :return_to, value: review_application_path(@application) %>
  <% end %>
  <%= button_to submit_application_path(@application), method: :post, class: "btn bg-blue #{"tooltipped tooltipped--n !pointer-events-auto" if blockers.any?}", disabled: blockers.any?, "aria-label": ("Still needed: #{blockers.to_sentence}" if blockers.any?) do %>
    Submit application
  <% end %>
<% end %>
