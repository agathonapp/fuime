<% title "Fuime Onboarding Videos" %>

<% content_for :info_pane do %>
  <div class="flex flex-col">
    <h2 class="text-4xl">
      Watch Fuime's onboarding videos
    </h2>

    <p class="mt-0 text-lg muted">
      Before signing the agreement, watch these two short videos to
      understand how Fuime operates
    </p>
  </div>
<% end %>

<div class="md:max-h-[75vh] flex flex-col gap-5" data-controller="onboarding-videos" data-onboarding-videos-button-id-value="continue_button">
  <% Event::Application::ONBOARDING_VIDEO_IDS.each_with_index do |video_id, index| %>
    <div class="flex gap-3 items-start flex-grow">
      <div class="flex items-center justify-center rounded-full border border-gray-300 h-8 w-8 shrink-0">
        <%= index + 1 %>
      </div>

      <div class="flex flex-col flex-grow gap-3">
        <div data-onboarding-videos-target="player" data-video-id="<%= video_id %>" class="flex-grow aspect-[560/315] min-h-0 max-w-full"></div>
      </div>
    </div>
  <% end %>
</div>

<% content_for :footer do %>
  <div class="flex gap-4">
    <a class="btn bg-muted" href="<%= application_path(@application) %>">← Back</a>
    <%= mobile_button_to archive_application_path(@application), text: "Archive application", icon: "delete", class: "btn btn--destroy", data: { turbo_confirm: "Are you sure you want to archive this application and remove it from your dashboard?" } %>
  </div>

  <%= button_to "Continue →", mark_videos_watched_application_path(@application), class: "btn bg-blue", method: :post, params: { event_application: { videos_watched: true } }, id: :continue_button, disabled: !@application.videos_watched %>
<% end %>
