<%# locals: (application: nil) %>

<div class="flex flex-col md:flex-row gap-6 lg:gap-4">
  <div class="md:sticky md:top-0 flex flex-col flex-grow justify-between w-full md:max-w-[50%] lg:max-w-md xl:max-w-lg lg:mx-6">

    <h2 class="text-5xl">
      <% if application.present? && application.created_at < 1.hour.ago %>
        Continue your application
      <% else %>
        Start your business
      <% end %>
    </h2>

    <p class="mt-0 mb-8 text-2xl muted">Setting up your Fuime business takes minutes</p>

    <div class="mb-12">
      <div class="flex flex-col gap-3">
        <div class="flex flex-row items-start justify-start gap-4">
          <%= inline_icon "idea" %>
          <p class="m-0 py-1">Tell us about your business and what you sell</p>
        </div>
        <div class="flex flex-row items-start justify-start gap-4">
          <%= inline_icon "person" %>
          <p class="m-0 py-1">Your parent will be your account's legal signer</p>
        </div>
        <div class="flex flex-row items-start justify-start gap-4">
          <%= inline_icon "clock" %>
          <p class="m-0 py-1">Start accepting payments in minutes</p>
        </div>
      </div>
    </div>

    <div class="max-w-lg">
      <h3 class="text-lg mb-0">Built for teen entrepreneurs</h3>
      <p class="mt-0">Fuime gives your venture clean books, receipts on every transaction, and tax tracking. Your parent signs as the responsible adult until you turn 18.</p>

      <%# Fuime: the way out for somebody who is not ready to answer "are you
          under 18" yet. /learn is public and needs no account, so this is the
          only page in the funnel where a visitor can go and read first — the
          alternative was closing the tab. Opens in a new tab so a part-filled
          application is never lost. %>
      <p class="mt-3 mb-0 muted">
        Don't know what you'd sell yet?
        <%= link_to "Read how it works and browse ten starter templates",
                    learn_path, target: "_blank", rel: "noopener", class: "underline" %>.
      </p>
    </div>

  </div>

  <div class="flex flex-col items-center flex-grow">
    <div class="md:max-w-[600px] w-full">
      <%= form_with model: @application || false, url: "#", method: @application.present? ? :patch : :post, id: @application.present? ? "edit_application_#{@application.id}" : "create_application", class: "mt-7" do |form| %>
        <%= form.hidden_field(:referral_code, value: @referral_code) if @referral_code.present? %>

        <%# Fuime: after the write-once 13+ checkbox, do not re-ask "are you
            under 18?". 13+ is not adulthood — only guardian-accept sets
            known_adult? — so teen_led defaults to true for everyone who is
            not a known adult. Unsigned visitors still pick. %>
        <% age_known = current_user.present? && (current_user.age_attestation.present? || current_user.birthday.present?) %>
        <% if age_known %>
          <%= form.hidden_field :teen_led, value: current_user.known_adult? ? "false" : "true" %>
          <div class="card card--outline mb-6">
            <p class="mt-0 mb-0">
              <% if current_user.known_adult? %>
                You're signed in as 18 or older. You can run this venture without a guardian.
              <% else %>
                You've confirmed you're 13 or older. Your parent or guardian is
                the legal signer — they approve payouts, not selling.
              <% end %>
            </p>
          </div>
        <% else %>
          <div class="card card--outline mb-6" x-data="{ teenager: '<%= @application&.teen_led? ? "true" : @application&.teen_led? == false ? "false" : "" %>' }">
            <%= form.label :teen_led do %>
              Are you under 18? <span class="text-primary">*</span>
            <% end %>

            <p class="text-sm muted mt-1 mb-2">Fuime is built for teen founders (13–17).</p>

            <div class="field field--options max-w-none mb-0 relative">
              <%= form.radio_button :teen_led, "true", { "x-model": "teenager", checked: @application&.teen_led?, required: true, class: "absolute !block opacity-0" } %>
              <%= form.label :teen_led, value: "true" do %>
                <strong>Yes, I'm under 18</strong>
                <small>13–17 years old</small>
              <% end %>
              <%= form.radio_button :teen_led, "false", { "x-model": "teenager", checked: @application&.teen_led? == false, required: true, class: "absolute !block opacity-0" } %>
              <%= form.label :teen_led, value: "false" do %>
                <strong>No, I'm 18+</strong>
                <small>Adult founder</small>
              <% end %>
            </div>

            <p class="text-sm muted mt-3 mb-0" x-show="teenager == 'true'">Your parent or guardian will be the legal signer. They approve payouts; you run the business.</p>
            <p class="text-sm muted mt-3 mb-0" x-show="teenager == 'false'">You can run your own venture on Fuime without a guardian.</p>
          </div>
        <% end %>
      <% end %>
    </div>

  </div>
</div>

  <% content_for :footer do %>
    <% if current_user.present? %>
      <div class="flex items-center justify-start gap-4">
        <%= responsive_link_to applications_path, text: "Back to dashboard", icon: "view-back", class: "btn bg-muted" %>

        <% if @application.present? %>
          <%= mobile_button_to archive_application_path(@application), text: "Archive application", icon: "delete", class: "btn btn--destroy", data: { turbo_confirm: "Are you sure you want to archive this application and remove it from your dashboard?", turbo_confirm_danger: true } %>
        <% end %>
      </div>
    <% else %>
      <span></span>
    <% end %>
    <% if application.present? %>
      <button class="btn bg-blue" formaction="<%= application_path(@application, return_to: business_type_application_path(@application)) %>" form="edit_application_<%= @application.id %>">Continue application</button>
    <% else %>
      <button class="btn bg-blue" formaction="<%= applications_path %>" form="create_application" id="start_application">Start application</button>
    <% end %>
  <% end %>
