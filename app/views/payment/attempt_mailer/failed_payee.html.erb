<p>Hello <%= @payment.legal_entity.name %>,</p>

<p>
  Your payment of <%= @payment.amount.format(with_currency: true) %> from <%= @payment.event.name %>
  for <i>"<%= @payment.purpose %>"</i> failed to send<%= @reason.present? ? ":" : "." %>
</p>

<% if @reason.present? %>
  <blockquote>
    <%= @reason %>
  </blockquote>
<% end %>

<p>
  Please login to Fuime to edit your payout information and retry the payment.
</p>

<p>
  Sincerely,
  <br><br>
  The Fuime Team
</p>

