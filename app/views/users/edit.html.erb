<% if @onboarding %>
  <% title "Create your account" %>
  <% page_full %>
  <% no_app_shell %>
  <style>
      html, body {
          overflow-x: hidden
      }

      @media (min-width: 640px) {
          html, body {
              height: 100vh;
              margin: 0;
              padding: 0;
          }
      }
  </style>
  <div class="sm:flex sm:w-screen sm:h-screen dark:bg-neutral-900">
    <div class="sm:flex-1 max-w-[1000px] p-6 pt-10 sm:p-16 sm:overflow-y-auto sm:h-screen max-w-screen">
      <div class="flex items-center justify-between">
        <img src="/logo-512.png" width="50px">
        <%= button_to logout_users_path,
                      method: :delete,
                      style: "box-shadow: none",
                      class: "pop mt-1 bg-transparent muted tooltipped tooltipped--s",
                      'aria-label': "Sign out" do %>
          <%= inline_icon "door-leave", size: home_action_size %>
        <% end %>
      </div>
      <h1 class="border-0 mt-10 mb-2">What should we call you?</h1>
      <turbo-frame id="settings" autoscroll data-autoscroll-behavior="smooth">
        <p class="muted">Your name and one checkbox. Less than two minutes.</p>
        <%# Fuime: no inline onsubmit here — phone_input.js (which owned the
            window.onsubmit hook) is not loaded on the onboarding branch. %>
        <%= form_with(model: @user, local: true, data: { turbo_frame: "_top" }) do |form| %>
          <%= form_errors @user, "profile", "We couldn't update your" %>
          <div class="md:flex gap-2">
            <div class="field flex-1">
              <%= form.label :full_name %>
              <%= form.text_field :full_name, required: true, placeholder: "Fiona Hackworth III", style: "max-width:100%", pattern: '^\S+.+' %>
              <% @user.errors.full_messages_for(:full_name).each do |message| %>
                <div class="primary"><%= message %></div>
              <% end %>
            </div>
            <div class="field flex-1">
              <%= form.label :preferred_name, "Preferred name (optional)" %>
              <%= form.text_field :preferred_name, style: "max-width:100%", placeholder: @user.full_name.presence || "FiFi Hacks", maxlength: 30 %>
            </div>
          </div>

          <%# Fuime: a confirmation, not a date of birth (2026-08-20).
              Signup asked every user for month, day and year. It now asks the
              one question the platform needs from a teenager — see
              AddAgeAttestationToUsers. The box on THIS page can only ever say
              "13 or older"; adulthood is asserted in the guardian flow. %>
          <div class="field">
            <% if @user.age_attestation.present? || @user.birthday.present? %>
              <%= form.label :age_attestation, "Your age" %>
              <p class="h5 muted mt0 mb0">
                <% if @user.known_adult? %>
                  You've confirmed you're 18 or older.
                <% else %>
                  You've confirmed you're 13 or older<%= " on #{@user.age_attested_at.to_fs(:long)}" if @user.age_attested_at %>.
                <% end %>
                <br>
                Need to correct this? Email <a href="mailto:support@fuime.com">support@fuime.com</a>.
              </p>
            <% else %>
              <div class="field field--checkbox">
                <%= check_box_tag "user[age_attestation_confirmed]", "1", false,
                                  id: "user_age_attestation_confirmed", required: true %>
                <%= label_tag "user_age_attestation_confirmed", "I'm 13 or older" %>
              </div>
              <p class="h5 muted mt0 mb0">
                Fuime is for founders 13 and up. Under 18, a parent or guardian joins
                your account later.
              </p>
            <% end %>
          </div>
          <%# Fuime: no phone number and no profile picture at signup
              (ONBOARDING_PLAN A2, 2026-09-10). Nothing between this form and a
              first sale reads either one: SMS login is offered only once a
              number has been verified (Login#sms_available?), so a blank number
              simply means email codes. Both fields stay on the settings branch
              below — Rule 2, disable rather than delete — and the phone-less
              check in LoginsController#complete is what keeps a user who skipped
              them from being bounced back here on every login. %>
          <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to] %>

          <%# Fuime: the terms have to appear where someone actually agrees to
              them. Published-but-unlinked documents are not notice, and this
              form is the moment a person becomes a Fuime user. %>
          <%# What the guardian's signature gates depends on the money model, so
              the last clause branches. Under merchant-of-record a vetted teen
              sells before a guardian signs and the guardian is required before
              any payout (Event#payout_setup_blockers); under Connect the venture
              cannot go live without one. %>
          <p class="muted text-sm mt-3 mb-2">
            By continuing you agree to Fuime's
            <%= link_to "Terms of Service", terms_path, target: "_blank" %> and
            <%= link_to "Privacy Policy", privacy_path, target: "_blank" %>.
            If you're under 18, a parent or guardian also accepts the
            <%= link_to "Guardian Agreement", guardian_agreement_path, target: "_blank" %>
            <% if ::Fuime::Features.merchant_of_record? %>
              before you can get paid.
            <% else %>
              before you can run a business.
            <% end %>
          </p>

          <div class="actions flex">
            <button type="submit" class="btn bg-info w-full gap-2">
              Let's go
              <%= inline_icon "enter", size: 40 %>
            </button>
          </div>
        <% end %>
      </turbo-frame>
    </div>
    <%# Hidden while onboarding_gallery is empty — an empty grid would render as
        a bare grey half-screen next to the signup form. %>
    <div class="hidden flex-1 bg-smoke dark:bg-neutral-800 <%= "sm:grid" if onboarding_gallery.any? %> h-screen"
         style="grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(4, 1fr);">
      <% onboarding_gallery.each do |image| %>
        <a href="<%= image[:url] %>" target="_blank" class="group relative flex w-full h-full min-w-0 min-h-0" style="background: <%= image[:overlay_color] %>">
          <img src="<%= image[:image] %>" class="w-full h-full object-cover opacity-45" style="object-position: <%= image[:object_position] || "top" %>">
          <%= inline_icon "external", class: "absolute top-0 right-0 m-5 text-white opacity-0 group-hover:opacity-100 transition-opacity" %>
        </a>
      <% end %>
    </div>
  </div>
<% else %>
  <% title "Account settings" %>
  <% page_md %>
  <%= render "users/nav", selected: :settings_home %>
  <% disabled = !policy(@user).update? %>
  <turbo-frame id="settings" autoscroll data-autoscroll-behavior="smooth">
    <%= render "settings_header", active: "general" unless @onboarding %>
    <section>
      <%= form_with(model: @user, local: true, html: { onsubmit: "onSubmit()" }, data: { turbo_frame: "_top" }) do |form| %>
        <%= form_errors @user, "profile", "We couldn't update your" %>
        <% if current_season(override_preference: true) %>
          <div class="field field--checkbox">
            <%= form.check_box :seasonal_themes_enabled, disabled: %>
            <%= form.label :seasonal_themes_enabled, "#{by_season "✨", override_preference: true, fall: "🎃", winter: "🎄"} Enable #{current_season(override_preference: true)} theme", class: "h3 bold" %>
          </div>
        <% end %>

        <div class="field">
          <%= form.label :full_name %>
          <%= form.text_field :full_name, required: true, placeholder: "Fiona Hackworth III", pattern: '^\S+.+', disabled: %>
          <% @user.errors.full_messages_for(:full_name).each do |message| %>
            <div class="primary"><%= message %></div>
          <% end %>
        </div>
        <div class="field">
          <%= form.label :preferred_name %>
          <p class="h5 muted mt0 mb1">If you go by a different name.</p>
          <%= form.text_field :preferred_name, placeholder: @user.full_name.presence || "FiFi Hacks", maxlength: 30, disabled: %>
        </div>

        <div class="field">
          <%= form.label :phone_number, "Mobile phone number" %>
          <% if @user.use_sms_auth %>
            <p class="h5 muted mt0 mb1">
              Changing your number will turn off SMS login codes.
            </p>
          <% end %>
          <%# Fuime A2: optional. Signup no longer asks for a phone number, so a
              user without one has to be able to save everything else on this
              page; a client-side `required` here blocked exactly that. The model
              already allows a blank (validates :phone_number, allow_blank). %>
          <%= form.hidden_field :phone_number, placeholder: "555-555-5555", id: "phone_number" %>
          <input type="tel" id="phone_raw" value="<%= @user.phone_number.presence %>" <%= "disabled" if disabled %>>
          <% if @user.phone_number_in_database.present? && !@user.phone_number_verified? %>
            <p class="h5 mt1 m0 warning flex items-center">
              <%= inline_icon "important-fill", class: "warning mr1", size: 20 %>
              <span>Your phone number is unverified. <%= link_to "Click here to verify it.", "#", class: "info", data: { behavior: "modal_trigger", modal: "verify_phone" } if current_user == @user %></span>
            </p>
          <% end %>
        </div>
        <%# Fuime: this used to be an editable date-of-birth field for every user.
            It is now admin-only and read-mostly.

            Two reasons. Ordinary users are no longer asked for a date at all, so
            rendering an empty date picker here invites them to supply one nobody
            needs. And :birthday is no longer a permitted parameter on this form
            (security review F-02) — leaving the input would post a value that is
            silently dropped, which is worse than not asking.

            Stripe genuinely requires a real date for an Issuing cardholder, and
            that flow collects it on its own form (stripe_cards/_form). %>
        <% if @user.birthday.present? || admin_signed_in? %>
          <div class="field">
            <%= form.label :birthday, "Date of birth" %>
            <p class="h5 muted mt0 mb1">
              Only needed for card issuing. Fuime asks everyone else to confirm they're
              13 or older instead.
            </p>
            <div class="flex items-center space-x-1">
              <% if @user.birthday.present? %>
                <span><%= @user.birthday.to_fs(:long) %></span>
                <% admin_tool("p-1.5 !ml-2") do %>
                  <%= @user.is_teenager? ? "✅ Teenager" : "Not a teenager" %>
                <% end %>
              <% else %>
                <span class="muted">Not on file — collected when a card is issued.</span>
              <% end %>
            </div>
          </div>
        <% end %>
        <div class="field">
          <%= form.label :email %>
          <%= form.email_field :email, disabled: %>
          <% if @user.email_updates.active.any? %>
            <p style="max-width: 420px;">
              <small>
                You've requested to update your email to <%= mail_to @user.email_updates.active.first.replacement %>.
                To continue, click on the verification and authorization links in both your new and old email inboxes
                respectively.
              </small>
            </p>
          <% end %>
        </div>
        <div class="field">
          <%= form.label :profile_picture %>
          <span class="muted block">Your profile picture is visible to anyone.</span>
          <p class="flex items-center mt1">
            <%= avatar_for @user, size: 48, class: "mr2" %>
            <span>
              <% if @user.profile_picture.attached? %>
                You're currently using an uploaded profile picture.<br>
                If you'd like to switch back to your Gravatar, <%= link_to "click here", user_delete_profile_picture_path(@user), method: :post %>.
              <% else %>
                If you have a <a href="https://gravatar.com" target="_blank">Gravatar</a>, we’ll pull it in here.<br>
                Or, you can upload a profile picture.<br>
              <% end %>
            </span>
          </p>
          <div data-controller="file-upload" data-file-upload-placeholder-value="Upload profile picture">
            <%= form.file_field :profile_picture, accept: "image/png, image/jpeg", class: "field--fileupload__field", direct_upload: true, disabled:, data: { "file-upload-target": "input" } %>
            <button data-file-upload-target="preview" type="button"></button>
            <div data-file-upload-target="clear"></div>
          </div>
        </div>

        <fieldset>
          <legend class="medium">Share usage data with Fuime</legend>
          <p class="h5 muted mt-0 mb-3">
            Help us improve Fuime by sending usage data.
            Off by default.
          </p>
          <div class="field field--options">
            <%= form.radio_button :sessions_reported, true, disabled: %>
            <%= form.label :sessions_reported, value: true do %>
              <%= inline_icon "support", size: 28 %>
              <strong>Sure thing!</strong>
            <% end %>
            <%= form.radio_button :sessions_reported, false, disabled: %>
            <%= form.label :sessions_reported, value: false do %>
              <%= inline_icon "thumbsdown", size: 28 %>
              <strong>No thanks</strong>
            <% end %>
          </div>
        </fieldset>

        <div class="actions flex">
          <%= form.submit "Save settings", disabled: %>
        </div>
      <% end %>
      <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/js/intlTelInput.min.js" integrity="sha512-QMUqEPmhXq1f3DnAVdXvu40C8nbTgxvBGvNruP6RFacy3zWKbNTmx7rdQVVM2gkd2auCWhlPYtcW2tHwzso4SA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
      <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.13/css/intlTelInput.css" integrity="sha512-gxWow8Mo6q6pLa1XH/CcH8JyiSDEtiwJV78E+D+QP0EVasFs8wKXq16G8CLD4CJ2SnonHr4Lm/yY2fSI2+cbmw==" crossorigin="anonymous" referrerpolicy="no-referrer">
      <%= javascript_include_tag "phone_input.js" %>
    </section>

    <% if @user.phone_number_in_database.present? %>
      <section class="modal modal--scroll bg-snow" data-behavior="modal" role="dialog" id="verify_phone">
        <%= modal_header "Verify phone number" %>
        <%= react_component "settings/SmsVerification",
                            phone_number: @user.phone_number_in_database %>
      </section>
    <% end %>
  </turbo-frame>
<% end %>
