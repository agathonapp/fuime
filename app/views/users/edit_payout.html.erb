<% title "Account settings" %>
<% page_md %>
<%= render "users/nav", selected: :settings_reimbursement_payouts %>

<turbo-frame id="settings" autoscroll data-autoscroll-behavior="smooth">
  <%= render "settings_header", active: "payouts", legal_entities: @legal_entities, legal_entity: @legal_entity %>
    <section>
      <% unless @legal_entity != @user.personal_legal_entity %>
        <%# FUIME-DISABLED: this paragraph led with reimbursements, linked to
            /my/reimbursements (route removed), and gave "you won't be able to
            submit reimbursement reports" as the reason to add a payout method —
            a reason that is no longer true and was never payable anyway. The
            surviving reason is real: payments from a business. %>
        <p class="muted mt0 mb2">
          When a <%= !@user.payments_received.exists? ? link_to("business sends you a payment", my_pay_path, data: { turbo_frame: "_top" }) : "business sends you a payment" %>, Fuime will use your preferred payout method to pay you. Without a payout method, you won't be able to accept payments from businesses on Fuime. You can update these settings at any time.
        </p>
      <% end %>
      <%= render "users/payout_methods_list", user: @user, legal_entity: @legal_entity, attempted: @payout_method %>
    </section>
</turbo-frame>
