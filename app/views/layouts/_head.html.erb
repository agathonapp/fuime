<%# locals: (title_suffix: "Fuime", admin: false, bare: false, force_light: false) %>

<title><%= yield(:title).concat(" – ") if content_for?(:title) %><%= title_suffix %></title>
<%= csrf_meta_tags %>
<%= csp_meta_tag %>
<meta name="theme-color" content="<%= @is_dark && !force_light ? "#0F172A" : "#F8FAFC" %>">
<meta name="apple-itunes-app" content="app-id=6465424810">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap" rel="stylesheet">

<%# Marketing pages force light, so skip the system-theme script that would flip them to dark. %>
<%= javascript_include_tag "dark", 'data-turbo-track': "reload" unless force_light %>
<%= javascript_include_tag "application", 'data-turbo-track': "reload", defer: true unless bare %>
<%= javascript_include_tag "bundle", 'data-turbo-track': "reload", defer: true %>

<% unless Rails.env.production? %>
  <meta name="turbo-prefetch" content="false">
<% end %>

<% unless admin %>
  <%= stylesheet_link_tag "application", media: "all", 'data-turbo-track': "reload" %>
  <% if Rails.env.production? %>
    <script>
      console.log(`%c
    ███████╗██╗   ██╗██╗███╗   ███╗███████╗
    ██╔════╝██║   ██║██║████╗ ████║██╔════╝
    █████╗  ██║   ██║██║██╔████╔██║█████╗
    ██╔══╝  ██║   ██║██║██║╚██╔╝██║██╔══╝
    ██║     ╚██████╔╝██║██║ ╚═╝ ██║███████╗
    ╚═╝      ╚═════╝ ╚═╝╚═╝     ╚═╝╚══════╝

    The financial home for teen businesses.
    Forked from HCB by Hack Club (AGPL-3.0)

    <%= Rails.configuration.constants.github_url %> <%# erb_lint:disable ErbSafety %>
      `, 'color: #0D6EFD; font-weight: bold; font-size: 10px;')
    </script>
  <% end %>

  <%# Web component used for TOTP / donation QR codes %>
  <script src="https://unpkg.com/@bitjson/qr-code@1.0.2/dist/qr-code.js"></script>
<% end %>

<meta name="format-detection" content="telephone=no">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#0D6EFD">
<meta name="msapplication-TileColor" content="#0D6EFD">

<% if content_for?(:favicon) %>
  <%= yield :favicon %>
<% elsif user_birthday? %>
  <link rel="icon" type="image/png" href="/favicon-party.gif">
<% else %>
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-<%= Rails.env %>-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-<%= Rails.env %>-16x16.png">
<% end %>

<%= render "application/seo_meta_tags" unless @skip_layout_og_tags %>
<%= yield(:head) if content_for?(:head) %>
