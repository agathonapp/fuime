# Copy to `.env` and fill in. `.env` is gitignored by the repo root.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Your PLATFORM account's secret key. Test mode only for this sample.
# Dashboard -> Developers -> API keys.
#
# NOTE FOR THIS REPO: the Fuime platform test key already lives in Render as
# STRIPE__TEST__SECRET_KEY on the fuime-web service. Do NOT reuse the Stripe CLI's
# default credentials on this machine — they belong to a "Hack Club Shop testing"
# account, and creating Fuime connected accounts under it would violate CLAUDE.md
# Rule 4.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME

# ── REQUIRED FOR WEBHOOKS ───────────────────────────────────────────────────

# Signing secret for THIN (v2) events. Printed by:
#   stripe listen --thin-events '...' --forward-thin-to localhost:4242/webhooks/thin
STRIPE_THIN_WEBHOOK_SECRET=whsec_REPLACE_ME

# Signing secret for SNAPSHOT (v1) events, used by the subscription flow. Printed by:
#   stripe listen --forward-to localhost:4242/webhooks/snapshot
# These are two separate listeners with two separate secrets. Sharing one secret
# between them makes every event fail signature verification.
STRIPE_SNAPSHOT_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── REQUIRED FOR THE SUBSCRIPTION FLOW ──────────────────────────────────────

# A recurring Price on your PLATFORM account (not on a connected account). This is
# what you charge ventures for using the platform.
# Create one: Dashboard -> Product catalogue -> add a recurring price.
STRIPE_PLATFORM_PRICE_ID=price_REPLACE_ME

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Where Stripe sends the user back to. Change if you are not on the default port.
APP_BASE_URL=http://localhost:4242

# Platform fee taken on each storefront sale, in basis points. 400 = 4%.
# Matches Event::Plan::FALLBACK_REVENUE_FEE in the main app.
PLATFORM_FEE_BPS=400
