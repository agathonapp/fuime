# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

.nova/*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore uploaded files in development
/storage/*

/node_modules
/yarn-error.log

/public/assets
.byebug_history

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key
.env*
!.env*example

latest.dump*
*.dump

.DS_Store

/public/packs
/public/packs-test
/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# IntelliJ
.idea

# Yard docs
.yardoc
/doc

# ctags
/tags
/app/assets/builds/*
!/app/assets/builds/.keep

# Code coverage report
/coverage

# AI
.claude/

# --- gambit repo-sentinel baseline (safe to extend, do not delete) ---
node_modules/
.venv/
venv/
__pycache__/
*.pyc
dist/
build/
out/
.next/
.turbo/
.parcel-cache/
target/
.gradle/
DerivedData/
*.xcuserstate
Pods/
*.xcworkspace/xcuserdata/
Thumbs.db
*.log
logs/
.env
.env.*
!.env.example
!.env.sample
*credentials*
*.pem
*.key
*.p12
*.pfx
*.mobileprovision
id_rsa*
id_ed25519*
*.keystore
*.jks
secrets.json
.netrc

# verify.mjs scroll-walk output
/shots/
